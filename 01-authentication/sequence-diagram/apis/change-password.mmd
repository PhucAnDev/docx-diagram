sequenceDiagram
    title POST /api/Auth/change-password
    actor User as User (Admin/Teacher/Parent)
    participant UI as ChangePasswordUI
    participant Endpoint as :AuthController
    participant Service as :AuthService
    participant Hasher as :PasswordHasherService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Nhập email, mật khẩu hiện tại, mật khẩu mới, xác nhận mật khẩu mới
    activate UI
    UI->>Endpoint: 2.1 POST /api/Auth/change-password (ChangePasswordRequest)
    activate Endpoint

    Endpoint->>Service: 3.1 ChangePasswordAsync(request)
    activate Service

    Service->>DB: 3.2 UserRepository.GetFirstOrDefaultAsync(u => u.Email == request.Email)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 User entity or null
    deactivate Database
    deactivate DB

    alt User not found (user == null)
        Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
        Endpoint-->>UI: 3.5.2 404 Not Found (User not found.)
    else User exists
        alt Field validation fails (empty, mismatch, or new matches current)
            Service-->>Endpoint: 3.6.1 (Succeeded = false, Errors)
            Endpoint-->>UI: 3.6.2 400 BadRequest (Errors)
        else Validation passes
            Service->>Hasher: 3.7 Verify(request.Password, user.PasswordHash)
            activate Hasher
            Hasher-->>Service: 3.8 Boolean match result
            deactivate Hasher

            alt Current password is incorrect
                Service-->>Endpoint: 3.9.1 (Succeeded = false, Error = "Current password is incorrect.")
                Endpoint-->>UI: 3.9.2 400 BadRequest (Current password is incorrect.)
            else Password matches
                Service->>Hasher: 3.10 Hash(request.NewPassword)
                activate Hasher
                Hasher-->>Service: 3.11 Hashed password string
                deactivate Hasher

                note over Service: user.PasswordHash = hashedNewPassword<br/>user.MustChangePassword = false<br/>user.UpdatedAt = DateTime.UtcNow

                Service->>DB: 3.12 SaveChangesAsync()
                activate DB
                DB->>Database: 3.13 Execute UPDATE query
                activate Database
                Database-->>DB: 3.14 Affected rows count
                deactivate Database
                deactivate DB

                Service-->>Endpoint: 3.15.1 (Succeeded = true)
                deactivate Service
                Endpoint-->>UI: 3.15.2 200 OK (Password changed successfully.)
            end
        end
    end
    deactivate Endpoint
    deactivate UI
