sequenceDiagram
    title POST /api/Auth/forgot-password
    actor User as User (Admin/Teacher/Parent)
    participant UI as ForgotPasswordUI
    participant Endpoint as :AuthController
    participant Service as :AuthService
    participant Cache as :DistributedCache
    participant Mail as :SmtpEmailService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Nhập email và gửi yêu cầu quên mật khẩu
    activate UI
    UI->>Endpoint: 2.1 POST /api/Auth/forgot-password (ForgotPasswordRequest)
    activate Endpoint

    Endpoint->>Service: 3.1 ForgotPasswordAsync(request.Email)
    activate Service

    Service->>DB: 3.2 UserRepository.GetFirstOrDefaultAsync(u => u.Email == email)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 User entity or null
    deactivate Database
    deactivate DB

    alt User not found (user == null)
        Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
        Endpoint-->>UI: 3.5.2 404 Not Found (User not found.)
    else User exists
        note over Service: Random.Shared.Next(100000, 999999) to get otpCode
        
        Service->>Cache: 3.6 SetStringAsync("otp:" + email, otpCode, expireIn5Minutes)
        activate Cache
        Cache-->>Service: 3.7 Success
        deactivate Cache

        Service->>Cache: 3.8 GetStringAsync("otp:" + email)
        activate Cache
        Cache-->>Service: 3.9 Saved otpCode string
        deactivate Cache

        alt Cache check fails (savedOtp != otpCode)
            Service-->>Endpoint: 3.10.1 (Succeeded = false, Error = "Failed to save OTP...")
            Endpoint-->>UI: 3.10.2 400 BadRequest (Forgot password failed.)
        else Cache check matches
            Service->>Mail: 3.11 SendEmailAsync(email, subject, body)
            activate Mail
            Mail-->>Service: 3.12 Success
            deactivate Mail

            alt Send email fails (Exception thrown)
                Service-->>Endpoint: 3.13.1 (Succeeded = false, Error = "Failed to send email...")
                Endpoint-->>UI: 3.13.2 400 BadRequest (Forgot password failed.)
            else Send email success
                Service-->>Endpoint: 3.14.1 (Succeeded = true)
                deactivate Service
                Endpoint-->>UI: 3.14.2 200 OK (OTP has been sent successfully.)
            end
        end
    end
    deactivate Endpoint
    deactivate UI
