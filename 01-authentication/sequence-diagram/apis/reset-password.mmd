sequenceDiagram
    title POST /api/Auth/reset-password
    actor User as User (Admin/Teacher/Parent)
    participant UI as ResetPasswordUI
    participant Endpoint as :AuthController
    participant Service as :AuthService
    participant Cache as :DistributedCache
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Nhập email, mật khẩu mới và OTP, nhấn Đặt lại mật khẩu
    activate UI
    UI->>Endpoint: 2.1 POST /api/Auth/reset-password (ResetPasswordRequest)
    activate Endpoint

    Endpoint->>Service: 3.1 ResetPasswordAsync(request)
    activate Service

    Service->>DB: 3.2 UserRepository.GetFirstOrDefaultAsync(u => u.Email == request.Email)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 User entity or null
    deactivate Database
    deactivate DB

    alt User not found (user == null)
        Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
        Endpoint-->>UI: 3.5.2 404 Not Found (User not found.)
    else User exists
        Service->>Cache: 3.6 GetStringAsync("otp:" + request.Email)
        activate Cache
        Cache-->>Service: 3.7 Saved OTP string
        deactivate Cache

        alt Saved OTP is empty or mismatch (savedOtp != request.Otp)
            Service-->>Endpoint: 3.8.1 (Succeeded = false, Error = "Invalid or expired OTP code.")
            Endpoint-->>UI: 3.8.2 400 BadRequest (Invalid or expired OTP code.)
        else OTP matches
            Service->>Cache: 3.9 RemoveAsync("otp:" + request.Email)
            activate Cache
            Cache-->>Service: 3.10 Success
            deactivate Cache

            note over Service: user.PasswordHash = BCrypt.HashPassword(request.NewPassword)<br/>user.UpdatedAt = DateTime.UtcNow
            
            Service->>DB: 3.11 SaveChangesAsync()
            activate DB
            DB->>Database: 3.12 Execute UPDATE query
            activate Database
            Database-->>DB: 3.13 Affected rows count
            deactivate Database
            deactivate DB

            alt Affected rows <= 0
                Service-->>Endpoint: 3.14.1 (Succeeded = false, Error = "Failed to reset password.")
                Endpoint-->>UI: 3.14.2 400 BadRequest (Failed to reset password.)
            else Success
                Service-->>Endpoint: 3.15.1 (Succeeded = true)
                deactivate Service
                Endpoint-->>UI: 3.15.2 200 OK (Password reset successfully.)
            end
        end
    end
    deactivate Endpoint
    deactivate UI
