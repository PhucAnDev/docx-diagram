sequenceDiagram
    title GET /api/Auth/verify-email
    actor User as User (Teacher/Parent)
    participant UI as VerifyEmailUI
    participant Endpoint as :AuthController
    participant Service as :AuthService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Nhấp vào liên kết xác nhận email từ hộp thư
    activate UI
    UI->>Endpoint: 2.1 GET /api/Auth/verify-email (token)
    activate Endpoint

    Endpoint->>Service: 3.1 VerifyEmailAsync(token)
    activate Service

    alt Token contains spaces (URL decoding issue)
        note over Service: token = token.Replace(" ", "+")
    end

    Service->>DB: 3.2 UserRepository.GetFirstOrDefaultAsync(u => u.VerifyToken == token)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 User entity or null
    deactivate Database
    deactivate DB

    alt User not found or Token expired (VerifyTokenExpiry < DateTime.UtcNow)
        Service-->>Endpoint: 3.5.1 (Succeeded = false, Error = "Token không hợp lệ hoặc đã hết hạn.")
        deactivate Service
        Endpoint-->>UI: 3.5.2 400 BadRequest (Token không hợp lệ hoặc đã hết hạn.)
    else Token valid and not expired
        activate Service
        note over Service: user.IsEmailVerified = true<br/>user.IsActive = true<br/>user.VerifyToken = null<br/>user.VerifyTokenExpiry = null<br/>user.UpdatedAt = DateTime.UtcNow
        
        Service->>DB: 3.6 SaveChangesAsync()
        activate DB
        DB->>Database: 3.7 Execute UPDATE query
        activate Database
        Database-->>DB: 3.8 Affected rows count
        deactivate Database
        deactivate DB

        Service-->>Endpoint: 3.9 (Succeeded = true)
        deactivate Service
        Endpoint-->>UI: 3.10 200 OK (Email xác minh thành công. Bạn có thể đăng nhập.)
    end
    deactivate Endpoint
    deactivate UI
