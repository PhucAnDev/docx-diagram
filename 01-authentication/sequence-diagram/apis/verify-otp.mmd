sequenceDiagram
    title POST /api/Auth/verify-otp
    actor User as User (Admin/Teacher/Parent)
    participant UI as VerifyOtpUI
    participant Endpoint as :AuthController
    participant Service as :AuthService
    participant Cache as :DistributedCache
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Nhập mã OTP nhận được từ email
    activate UI
    UI->>Endpoint: 2.1 POST /api/Auth/verify-otp (VerifyOtpRequest)
    activate Endpoint

    Endpoint->>Service: 3.1 VerifyOtpAsync(request.Email, request.Otp)
    activate Service

    Service->>DB: 3.2 UserRepository.GetFirstOrDefaultAsync(u => u.Email == email)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 User entity or null
    deactivate Database
    deactivate DB

    alt User not found (user == null)
        Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
        Endpoint-->>UI: 3.5.2 404 Not Found (User not found.)
    else User exists
        Service->>Cache: 3.6 GetStringAsync("otp:" + email)
        activate Cache
        Cache-->>Service: 3.7 Saved OTP string
        deactivate Cache

        alt Saved OTP is empty or mismatch (savedOtp != otp)
            Service-->>Endpoint: 3.8.1 (Succeeded = false, Error = "Mã OTP không hợp lệ hoặc đã hết hạn.")
            deactivate Service
            Endpoint-->>UI: 3.8.2 400 BadRequest (Mã OTP không hợp lệ hoặc đã hết hạn.)
        else OTP matches
            activate Service
            Service-->>Endpoint: 3.9.1 (Succeeded = true)
            deactivate Service
            Endpoint-->>UI: 3.9.2 200 OK (OTP xác nhận thành công.)
        end
    end
    deactivate Endpoint
    deactivate UI
