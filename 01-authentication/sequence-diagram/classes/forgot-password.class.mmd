classDiagram
    direction TB

    class AuthController {
        -authService: IAuthService
        +ForgotPassword(request: ForgotPasswordRequest) Task~ActionResult~
    }

    class ForgotPasswordRequest {
        +Email: string
    }

    class IAuthService {
        <<interface>>
        +ForgotPasswordAsync(email: string) Task~Tuple~bool,bool,IEnumerable~string~~~~
    }

    class AuthService {
        -unitOfWork: IUnitOfWork
        -cache: IDistributedCache
        -mailService: IMailService
        +ForgotPasswordAsync(email: string) Task~Tuple~bool,bool,IEnumerable~string~~~~
    }

    class IDistributedCache {
        <<interface>>
        +GetStringAsync(key: string) Task~string~
        +SetStringAsync(key: string, value: string, options: DistributedCacheEntryOptions) Task
    }

    class IMailService {
        <<interface>>
        +SendEmailAsync(to: string, subject: string, body: string) Task
    }

    class IUnitOfWork {
        <<interface>>
        +UserRepository: IUserRepository
    }

    class UnitOfWork {
        -context: AppDbContext
        +UserRepository: IUserRepository
    }

    class User {
        +Email: string
        +FullName: string
    }

    AuthController ..> ForgotPasswordRequest : uses
    AuthController ..> IAuthService : uses
    IAuthService <.. AuthService : implements
    AuthService ..> IDistributedCache : uses
    AuthService ..> IMailService : uses
    AuthService ..> IUnitOfWork : uses
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> User : uses
