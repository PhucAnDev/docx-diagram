%%{init: {'theme':'base', 'flowchart':{'nodeSpacing':120,'rankSpacing':160,'curve':'linear'}, 'themeVariables': {'mainBkg':'#ffffff','nodeBorder':'#000000','clusterBkg':'#ffffff','clusterBorder':'#000000','titleColor':'#000000','edgeLabelBackground':'#ffffff','classText':'#000000','lineColor':'#000000','primaryColor':'#ffffff','primaryTextColor':'#000000','primaryBorderColor':'#000000'}}}%%
classDiagram
    direction TB

    class AuthController {
        -authService: IAuthService
        -cache: IDistributedCache
        +Login(request: LoginRequest) Task~ActionResult~
    }

    class LoginRequest {
        +Email: string
        +Password: string
    }

    class IAuthService {
        <<interface>>
        +LoginAsync(request: LoginRequest) Task~Tuple~bool,IEnumerable~string~,TokenModel~~~~
    }

    class AuthService {
        -unitOfWork: IUnitOfWork
        -tokenService: ITokenService
        -cache: IDistributedCache
        -mailService: IMailService
        -passwordHasherService: IPasswordHasherService
        +LoginAsync(request: LoginRequest) Task~Tuple~bool,IEnumerable~string~,TokenModel~~~~
    }

    class ITokenService {
        <<interface>>
        +GenerateAccessToken(user: User) string
        +GenerateRefreshToken() string
    }

    class IDistributedCache {
        <<interface>>
        +SetStringAsync(key: string, value: string, options: DistributedCacheEntryOptions) Task
    }

    class TokenModel {
        +AccessToken: string
        +RefreshToken: string
        +User: UserAuthInfo
    }

    class UserAuthInfo {
        +Id: int
        +Email: string
        +FullName: string
        +Phone: string
        +RoleName: string
        +IsActive: bool
        +MustChangePassword: bool
    }

    class IUnitOfWork {
        <<interface>>
        +UserRepository: IUserRepository
        +SaveChangesAsync() Task~int~
    }

    class UnitOfWork {
        -context: AppDbContext
        +UserRepository: IUserRepository
        +SaveChangesAsync() Task~int~
    }

    class User {
        +Avatar: string
        +PasswordHash: string
        +FullName: string
        +Email: string
        +Phone: string
        +IsActive: bool
        +Gender: string
        +Specialty: string
        +IsEmailVerified: bool
        +MustChangePassword: bool
        +RoleId: int
    }

    class Role {
        +RoleName: UserRole
    }

    AuthController ..> LoginRequest : uses
    AuthController ..> IAuthService : uses
    AuthService ..> ITokenService : uses
    AuthService ..> IDistributedCache : uses
    AuthService ..> IUnitOfWork : uses
    AuthService ..> TokenModel : uses
    TokenModel ..> UserAuthInfo : uses
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> User : uses
    User ..> Role : uses
    IAuthService <.. AuthService : implements
