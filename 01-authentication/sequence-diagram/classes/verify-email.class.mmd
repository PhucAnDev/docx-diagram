classDiagram
    direction TB

    class AuthController {
        -authService: IAuthService
        +VerifyEmail(token: string) Task~ActionResult~
    }

    class IAuthService {
        <<interface>>
        +VerifyEmailAsync(token: string) Task~Tuple~bool,IEnumerable~string~~~~
    }

    class AuthService {
        -unitOfWork: IUnitOfWork
        +VerifyEmailAsync(token: string) Task~Tuple~bool,IEnumerable~string~~~~
    }

    class IUnitOfWork {
        <<interface>>
        +UserRepository: IUserRepository
        +SaveChangesAsync() Task~int~
    }

    class UnitOfWork {
        -context: AppDbContext
        +UserRepository: IUserRepository
        +SaveChangesAsync() Task~int~
    }

    class User {
        +VerifyToken: string
        +VerifyTokenExpiry: DateTime?
        +IsEmailVerified: bool
        +IsActive: bool
    }

    AuthController ..> IAuthService : uses
    IAuthService <.. AuthService : implements
    AuthService ..> IUnitOfWork : uses
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> User : uses
