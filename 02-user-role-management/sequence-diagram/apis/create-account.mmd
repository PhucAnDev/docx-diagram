sequenceDiagram
    title POST /api/Users/create-account
    actor User as User (Admin/Teacher)
    participant UI as CreateAccountUI
    participant Endpoint as :UsersController
    participant Service as :UserService
    participant Mail as :SmtpEmailService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Điền thông tin họ tên, email, vai trò và tạo tài khoản
    activate UI
    UI->>Endpoint: 2.1 POST /api/Users/create-account (CreateAccountRequest)
    activate Endpoint

    alt ModelState.IsValid == false
        Endpoint-->>UI: 2.2 400 Bad Request
    else ModelState.IsValid == true
        Endpoint->>Service: 3.1 CreateAccountAsync(request)
        activate Service

        Service->>DB: 3.2 UserRepository.ExistsAsync(u => u.Email == request.Email && !u.IsDeleted)
        activate DB
        DB->>Database: 3.3 Execute SELECT count query
        activate Database
        Database-->>DB: 3.4 Email exists boolean
        deactivate Database
        deactivate DB

        Service->>DB: 3.5 RoleRepository.GetFirstOrDefaultAsync(r => r.RoleName == request.RoleName && r.IsActive)
        activate DB
        DB->>Database: 3.6 Execute SELECT query
        activate Database
        Database-->>DB: 3.7 Role entity or null
        deactivate Database
        deactivate DB

        alt Email exists OR Role is invalid
            Service-->>Endpoint: 3.8.1 (Succeeded = false, Errors list)
            deactivate Service
            Endpoint-->>UI: 3.8.2 400 Bad Request (Tạo tài khoản thất bại.)
        else Valid input
            note over Service: Generate temporaryPassword & verifyToken<br/>Hash temporaryPassword using BCrypt
            
            Service->>DB: 3.9 UserRepository.AddAsync(user)
            activate DB
            DB-->>Service: 3.10 Success
            deactivate DB

            Service->>DB: 3.11 SaveChangesAsync()
            activate DB
            DB->>Database: 3.12 Execute INSERT query
            activate Database
            Database-->>DB: 3.13 Rows affected
            deactivate Database
            deactivate DB

            note over Service: Build verifyLink using token and config FrontendBaseUrl
            
            Service->>Mail: 3.14 SendEmailAsync(email, subject, body)
            activate Mail
            
            alt Send email success
                Mail-->>Service: Success
                deactivate Mail
                Service-->>Endpoint: 3.15.1 (Succeeded = true, CreateAccountResponse)
                deactivate Service
                Endpoint-->>UI: 3.15.2 200 OK (Tạo tài khoản thành công.)
            else Send email throws exception
                activate Mail
                Mail-->>Service: Throw Exception
                deactivate Mail
                Service-->>Endpoint: 3.16.1 (Succeeded = false, Error = "Gửi email thất bại...")
                deactivate Service
                Endpoint-->>UI: 3.16.2 400 Bad Request (Tạo tài khoản thất bại.)
            end
        end
    end
    deactivate Endpoint
    deactivate UI
