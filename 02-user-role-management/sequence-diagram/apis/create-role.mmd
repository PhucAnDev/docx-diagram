sequenceDiagram
    title POST /api/Roles
    actor Admin as Admin
    participant UI as CreateRoleUI
    participant Endpoint as :RolesController
    participant Service as :RoleService
    participant DB as :UnitOfWork
    participant Database as :Database

    Admin->>UI: 1.1 Nhập tên vai trò, mô tả và nhấn Tạo mới
    activate UI
    UI->>Endpoint: 2.1 POST /api/Roles (CreateRoleRequest)
    activate Endpoint

    Endpoint->>Service: 3.1 CreateRoleAsync(request)
    activate Service

    Service->>DB: 3.2 RoleRepository.ExistsAsync(r => r.RoleName == request.RoleName && !r.IsDeleted)
    activate DB
    DB->>Database: 3.3 Execute SELECT count query
    activate Database
    Database-->>DB: 3.4 Role exists boolean
    deactivate Database
    deactivate DB

    alt Role already exists
        Service-->>Endpoint: 3.5.1 (Succeeded = false, Error = "Role already exists.")
        deactivate Service
        Endpoint-->>UI: 3.5.2 400 Bad Request (Create role failed.)
    else Role is unique
        activate Service
        note over Service: Create Role entity with RoleName, Description, IsActive = true
        
        Service->>DB: 3.6 RoleRepository.AddAsync(role)
        activate DB
        DB-->>Service: 3.7 Success
        deactivate DB

        Service->>DB: 3.8 SaveChangesAsync()
        activate DB
        DB->>Database: 3.9 Execute INSERT query
        activate Database
        Database-->>DB: 3.10 Rows affected
        deactivate Database
        deactivate DB

        Service-->>Endpoint: 3.11 (Succeeded = true, RoleResponse)
        deactivate Service
        Endpoint-->>UI: 3.12 200 OK (Role created.)
    end
    deactivate Endpoint
    deactivate UI
