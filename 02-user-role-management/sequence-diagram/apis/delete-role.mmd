sequenceDiagram
    title DELETE /api/Roles/{id}
    actor Admin as Admin
    participant UI as DeleteRoleUI
    participant Endpoint as :RolesController
    participant Service as :RoleService
    participant DB as :UnitOfWork
    participant Database as :Database

    Admin->>UI: 1.1 Yêu cầu xóa vai trò
    activate UI
    UI->>Endpoint: 2.1 DELETE /api/Roles/{id}
    activate Endpoint

    alt id <= 0
        Endpoint-->>UI: 2.2 400 Bad Request (Invalid role id.)
    else id > 0
        Endpoint->>Service: 3.1 DeleteRoleAsync(id)
        activate Service

        Service->>DB: 3.2 RoleRepository.GetFirstOrDefaultAsync(r => r.Id == id && !r.IsDeleted)
        activate DB
        DB->>Database: 3.3 Execute SELECT query
        activate Database
        Database-->>DB: 3.4 Role entity or null
        deactivate Database
        deactivate DB

        alt Role not found (role == null)
            Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
            deactivate Service
            Endpoint-->>UI: 3.5.2 404 Not Found (Role not found.)
        else Role exists
            note over Service: role.IsDeleted = true<br/>role.IsActive = false<br/>role.DeletedAt = DateTime.UtcNow<br/>role.UpdatedAt = DateTime.UtcNow

            Service->>DB: 3.6 RoleRepository.Update(role)
            activate DB
            DB-->>Service: 3.7 Success
            deactivate DB

            Service->>DB: 3.8 SaveChangesAsync()
            activate DB
            DB->>Database: 3.9 Execute UPDATE query
            activate Database
            Database-->>DB: 3.10 Rows affected
            deactivate Database
            deactivate DB

            Service-->>Endpoint: 3.11 (Succeeded = true)
            deactivate Service
            Endpoint-->>UI: 3.12 200 OK (Role deleted.)
        end
    end
    deactivate Endpoint
    deactivate UI
