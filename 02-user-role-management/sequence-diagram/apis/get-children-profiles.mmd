sequenceDiagram
    title GET /api/Users/children-profiles
    actor User as User
    participant UI as ChildrenProfilesUI
    participant Endpoint as :UsersController
    participant Service as :UserService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu hiển thị danh sách hồ sơ trẻ của mình
    activate UI
    UI->>Endpoint: 2.1 GET /api/Users/children-profiles
    activate Endpoint

    Endpoint->>Service: 3.1 GetCurrentUserWithChildrenProfilesAsync(userId)
    activate Service

    Service->>DB: 3.2 UserRepository.GetByIdWithChildProfilesAsync(userId)
    activate DB
    DB->>Database: 3.3 Execute SELECT with includes
    activate Database
    Database-->>DB: 3.4 User entity with ChildProfiles or null
    deactivate Database
    deactivate DB

    alt User not found (user == null)
        Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
        deactivate Service
        Endpoint-->>UI: 3.5.2 404 Not Found (User not found.)
    else User exists
        Service-->>Endpoint: 3.6.1 (Succeeded = true, UserWithChildrenProfileResponse)
        deactivate Service
        Endpoint-->>UI: 3.6.2 200 OK (UserWithChildrenProfileResponse)
    end
    deactivate Endpoint
    deactivate UI
