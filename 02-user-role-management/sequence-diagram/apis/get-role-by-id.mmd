sequenceDiagram
    title GET /api/Roles/{id}
    actor User as User
    participant UI as GetRoleByIdUI
    participant Endpoint as :RolesController
    participant Service as :RoleService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu hiển thị chi tiết vai trò
    activate UI
    UI->>Endpoint: 2.1 GET /api/Roles/{id}
    activate Endpoint

    alt id <= 0
        Endpoint-->>UI: 2.2 400 Bad Request (Invalid role id.)
    else id > 0
        Endpoint->>Service: 3.1 GetRoleByIdAsync(id)
        activate Service

        Service->>DB: 3.2 RoleRepository.GetFirstOrDefaultAsync(r => r.Id == id && !r.IsDeleted, tracked: false)
        activate DB
        DB->>Database: 3.3 Execute SELECT query
        activate Database
        Database-->>DB: 3.4 Role entity or null
        deactivate Database
        deactivate DB

        alt Role not found (role == null)
            Service-->>Endpoint: 3.5.1 null
            deactivate Service
            Endpoint-->>UI: 3.5.2 404 Not Found (Role not found.)
        else Role exists
            Service-->>Endpoint: 3.6.1 RoleResponse
            deactivate Service
            Endpoint-->>UI: 3.6.2 200 OK (RoleResponse)
        end
    end
    deactivate Endpoint
    deactivate UI
