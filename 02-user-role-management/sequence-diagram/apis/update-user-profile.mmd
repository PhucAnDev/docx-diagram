%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title PUT /api/Users/{id}
    actor User as User (Admin/Teacher/Parent)
    participant UI as UpdateUserProfileUI
    participant Endpoint as :UsersController
    participant Service as :UserService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Chỉnh sửa thông tin cá nhân và nhấn Lưu
    activate UI
    UI->>Endpoint: 2.1 PUT /api/Users/{id} (UpdateUserRequest)
    activate Endpoint

    alt id <= 0
        Endpoint-->>UI: 2.2 400 Bad Request (Invalid user id.)
    else id > 0
        Endpoint->>Service: 3.1 UpdateUserAsync(id, request)
        activate Service

        Service->>DB: 3.2 UserRepository.GetFirstOrDefaultAsync(u => u.Id == id && !u.IsDeleted, includeProperties: "Role")
        activate DB
        DB->>Database: 3.3 Execute SELECT query
        activate Database
        Database-->>DB: 3.4 User entity with Role or null
        deactivate Database
        deactivate DB

        alt User not found (user == null)
            Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
            Endpoint-->>UI: 3.5.2 404 Not Found (User not found.)
        else User exists
            opt Email is updated
                Service->>DB: 3.6 UserRepository.ExistsAsync(u => u.Email == request.Email && u.Id != id && !u.IsDeleted)
                activate DB
                DB->>Database: 3.7 Execute SELECT count query
                activate Database
                Database-->>DB: 3.8 Email exists boolean
                deactivate Database
                deactivate DB
            end

            opt RoleName is updated
                Service->>DB: 3.9 RoleRepository.GetFirstOrDefaultAsync(r => r.RoleName == request.RoleName && r.IsActive)
                activate DB
                DB->>Database: 3.10 Execute SELECT query
                activate Database
                Database-->>DB: 3.11 Role entity or null
                deactivate Database
                deactivate DB
            end

            alt Email already exists OR Role is invalid
                Service-->>Endpoint: 3.12.1 (Succeeded = false, Errors list)
                Endpoint-->>UI: 3.12.2 400 Bad Request (Update user failed.)
            else Valid input
                note over Service: Update remaining user fields (Avatar, FullName, Gender, Specialty, Phone, IsActive)<br/>user.UpdatedAt = DateTime.UtcNow
                
                Service->>DB: 3.13 UserRepository.Update(user)
                activate DB
                DB-->>Service: 3.14 Success
                deactivate DB

                Service->>DB: 3.15 SaveChangesAsync()
                activate DB
                DB->>Database: 3.16 Execute UPDATE query
                activate Database
                Database-->>DB: 3.17 Rows affected
                deactivate Database
                deactivate DB

                Service-->>Endpoint: 3.18 (Succeeded = true, UserResponse)
                deactivate Service
                Endpoint-->>UI: 3.19 200 OK (User updated.)
            end
        end
    end
    deactivate Endpoint
    deactivate UI
