classDiagram
    direction TB

    class RolesController {
        -roleService: IRoleService
        +Delete(id: int) Task~ActionResult~
    }

    class IRoleService {
        <<interface>>
        +DeleteRoleAsync(id: int) Task~Tuple~bool,bool,IEnumerable~string~~~~
    }

    class RoleService {
        -unitOfWork: IUnitOfWork
        +DeleteRoleAsync(id: int) Task~Tuple~bool,bool,IEnumerable~string~~~~
    }

    class IUnitOfWork {
        <<interface>>
        +RoleRepository: IRoleRepository
        +SaveChangesAsync() Task~int~
    }

    class UnitOfWork {
        -context: AppDbContext
        +RoleRepository: IRoleRepository
        +SaveChangesAsync() Task~int~
    }

    class Role {
        +IsDeleted: bool
        +IsActive: bool
        +DeletedAt: DateTime?
        +UpdatedAt: DateTime
    }

    RolesController ..> IRoleService : uses
    IRoleService <.. RoleService : implements
