classDiagram
    direction TB

    class UsersController {
        -userService: IUserService
        +Delete(id: int) Task~ActionResult~
    }

    class IUserService {
        <<interface>>
        +DeleteUserAsync(id: int) Task~Tuple~bool,bool,IEnumerable~string~~~~
    }

    class UserService {
        -unitOfWork: IUnitOfWork
        +DeleteUserAsync(id: int) Task~Tuple~bool,bool,IEnumerable~string~~~~
    }

    class IUnitOfWork {
        <<interface>>
        +UserRepository: IUserRepository
        +SaveChangesAsync() Task~int~
    }

    class UnitOfWork {
        -context: AppDbContext
        +UserRepository: IUserRepository
        +SaveChangesAsync() Task~int~
    }

    class User {
        +IsDeleted: bool
        +DeletedAt: DateTime?
        +UpdatedAt: DateTime
    }

    UsersController ..> IUserService : uses
    IUserService <.. UserService : implements
    UserService ..> IUnitOfWork : uses
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> User : uses
