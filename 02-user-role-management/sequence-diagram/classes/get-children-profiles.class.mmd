classDiagram
    direction TB

    class UsersController {
        -userService: IUserService
        +GetCurrentUserChildrenProfiles() Task~ActionResult~
        -GetUserId() int
    }

    class IUserService {
        <<interface>>
        +GetCurrentUserWithChildrenProfilesAsync(userId: int) Task~Tuple~bool,bool,IEnumerable~string~,UserWithChildrenProfileResponse~~~~
    }

    class UserService {
        -unitOfWork: IUnitOfWork
        -mapper: IMapper
        +GetCurrentUserWithChildrenProfilesAsync(userId: int) Task~Tuple~bool,bool,IEnumerable~string~,UserWithChildrenProfileResponse~~~~
    }

    class IUnitOfWork {
        <<interface>>
        +UserRepository: IUserRepository
    }

    class UnitOfWork {
        -context: AppDbContext
        +UserRepository: IUserRepository
    }

    class UserWithChildrenProfileResponse {
        +Id: int
        +FullName: string
        +Email: string
        +ChildProfiles: List~ChildProfileResponse~
    }

    class ChildProfileResponse {
        +Id: int
        +FullName: string
        +Age: int
        +Gender: string
        +LearningLevel: string
        +Status: string
    }

    class User {
        +FullName: string
        +Email: string
        +ChildProfiles: ICollection~ChildProfile~
    }

    class ChildProfile {
        +FullName: string
        +Age: int
        +Gender: string
        +LearningLevel: string
        +Status: string
    }

    UsersController ..> IUserService : uses
