%%{init: {'theme':'base', 'flowchart':{'nodeSpacing':120,'rankSpacing':160,'curve':'linear'}, 'themeVariables': {'mainBkg':'#ffffff','nodeBorder':'#000000','clusterBkg':'#ffffff','clusterBorder':'#000000','titleColor':'#000000','edgeLabelBackground':'#ffffff','classText':'#000000','lineColor':'#000000','primaryColor':'#ffffff','primaryTextColor':'#000000','primaryBorderColor':'#000000'}}}%%
classDiagram
    direction TB

    class RolesController {
        -roleService: IRoleService
        +GetList(pageNumber: int, pageSize: int) Task~ActionResult~
    }

    class IRoleService {
        <<interface>>
        +GetListRoleAsync(pageNumber: int, pageSize: int) Task~PagedResponse~RoleResponse~~
    }

    class RoleService {
        -unitOfWork: IUnitOfWork
        +GetListRoleAsync(pageNumber: int, pageSize: int) Task~PagedResponse~RoleResponse~~
    }

    class IUnitOfWork {
        <<interface>>
        +RoleRepository: IRoleRepository
    }

    class UnitOfWork {
        -context: AppDbContext
        +RoleRepository: IRoleRepository
    }

    class RoleResponse {
        +Id: int
        +RoleName: string
        +Description: string
        +IsActive: bool
        +CreatedAt: DateTime
        +UpdatedAt: DateTime
    }

    class PagedResponse~T~ {
        +PageNumber: int
        +PageSize: int
        +TotalCount: int
        +TotalPages: int
        +Items: List~T~
    }

    class Role {
        +RoleName: UserRole
        +Description: string
        +IsActive: bool
        +IsDeleted: bool
    }

    RolesController ..> IRoleService : uses
    IRoleService <.. RoleService : implements
    RoleService ..> IUnitOfWork : uses
    RoleService ..> PagedResponse~RoleResponse~ : uses
    PagedResponse~RoleResponse~ ..> RoleResponse : wraps
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> Role : uses
