%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title DELETE /api/classrooms/{id}
    actor Admin as Admin
    participant UI as DeleteClassroomUI
    participant Endpoint as :ClassroomsController
    participant Service as :ClassroomService
    participant DB as :UnitOfWork
    participant Database as :Database

    Admin->>UI: 1.1 Yêu cầu xóa lớp học
    activate UI
    UI->>Endpoint: 2.1 DELETE /api/classrooms/{id}
    activate Endpoint

    Endpoint->>Service: 3.1 DeleteClassroomAsync(id)
    activate Service

    Service->>DB: 3.2 ClassroomRepository.GetFirstOrDefaultAsync(c => c.Id == id && !c.IsDeleted, includeProperties: "Enrollments")
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 Classroom entity or null
    deactivate Database
    deactivate DB

    alt Classroom not found
        Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
        Endpoint-->>UI: 3.5.2 404 Not Found (Classroom not found.)
    else Classroom exists
        alt Active enrollments exist in classroom (classroom.Enrollments.Any(e => !e.IsDeleted && e.Status == "Active"))
            Service-->>Endpoint: 3.6.1 (Succeeded = false, Error = "Không thể xóa lớp học có học sinh đang học.")
            Endpoint-->>UI: 3.6.2 400 Bad Request (Không thể xóa lớp học...)
        else No active enrollments
            alt Classroom is Active (classroom.Status == "Active")
                Service-->>Endpoint: 3.7.1 (Succeeded = false, Error = "Không thể xóa lớp học đang ở trạng thái Hoạt động.")
                Endpoint-->>UI: 3.7.2 400 Bad Request (Không thể xóa lớp học...)
            else Classroom not Active (Pending/Cancelled)
                note over Service: classroom.IsDeleted = true<br/>classroom.DeletedAt = DateTime.UtcNow<br/>classroom.UpdatedAt = DateTime.UtcNow

                Service->>DB: 3.8 SaveChangesAsync()
                activate DB
                DB->>Database: 3.9 Execute UPDATE query
                activate Database
                Database-->>DB: 3.10 Rows affected
                deactivate Database
                deactivate DB

                Service-->>Endpoint: 3.11 (Succeeded = true)
                deactivate Service
                Endpoint-->>UI: 3.12 200 OK (Classroom deleted successfully.)
            end
        end
    end
    deactivate Endpoint
    deactivate UI
