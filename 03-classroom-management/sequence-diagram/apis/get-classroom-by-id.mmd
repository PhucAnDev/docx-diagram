%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title GET /api/classrooms/{id}
    actor User as User (Admin/Teacher/Parent)
    participant UI as GetClassroomByIdUI
    participant Endpoint as :ClassroomsController
    participant Service as :ClassroomService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu hiển thị thông tin chi tiết lớp học
    activate UI
    UI->>Endpoint: 2.1 GET /api/classrooms/{id}
    activate Endpoint

    Endpoint->>Service: 3.1 GetClassroomByIdAsync(id)
    activate Service

    Service->>DB: 3.2 ClassroomRepository.GetFirstOrDefaultAsync(c => c.Id == id && !c.IsDeleted, includeProperties: "User,User.Role,Program,Semester,Enrollments", tracked: false)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 Classroom entity with details or null
    deactivate Database
    deactivate DB

    alt Classroom not found (classroom == null)
        Service-->>Endpoint: 3.5.1 null
        Endpoint-->>UI: 3.5.2 404 Not Found (Classroom not found.)
    else Classroom exists
        Service-->>Endpoint: 3.6.1 ClassroomResponse
        deactivate Service
        Endpoint-->>UI: 3.6.2 200 OK (ClassroomResponse)
    end
    deactivate Endpoint
    deactivate UI
