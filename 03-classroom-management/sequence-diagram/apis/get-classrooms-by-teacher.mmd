sequenceDiagram
    title GET /api/classrooms/{teacherId}/classrooms
    actor User as User (Admin/Teacher)
    participant UI as TeacherClassroomsUI
    participant Endpoint as :ClassroomsController
    participant Service as :ClassroomService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu xem danh sách lớp học được phân công
    activate UI
    UI->>Endpoint: 2.1 GET /api/classrooms/{teacherId}/classrooms (pageNumber, pageSize)
    activate Endpoint

    alt teacherId <= 0
        Endpoint-->>UI: 2.2 400 Bad Request (Mã định danh giáo viên không hợp lệ.)
    else teacherId > 0
        Endpoint->>Service: 3.1 GetClassroomsByTeacherIdAsync(teacherId, pageNumber, pageSize)
        activate Service

        Service->>DB: 3.2 UserRepository.GetFirstOrDefaultAsync(u => u.Id == teacherId && !u.IsDeleted && u.IsActive && u.Role.RoleName == UserRole.Teacher, includeProperties: "Role", tracked: false)
        activate DB
        DB->>Database: 3.3 Execute SELECT query
        activate Database
        Database-->>DB: 3.4 Teacher entity or null
        deactivate Database
        deactivate DB

        alt Teacher not found or inactive
            Service-->>Endpoint: 3.5.1 Empty PagedResponse
            deactivate Service
            Endpoint-->>UI: 3.5.2 200 OK (Empty PagedResponse)
        else Teacher valid
            activate Service
            Service->>DB: 3.6 ClassroomRepository.GetPagedAsync(pageNumber, pageSize, c => !c.IsDeleted && c.UserId == teacherId, includeProperties: "User,User.Role,Program,Semester,Enrollments")
            activate DB
            DB->>Database: 3.7 Execute SELECT query with pagination
            activate Database
            Database-->>DB: 3.8 Paged list of Classrooms
            deactivate Database
            deactivate DB

            Service-->>Endpoint: 3.9 PagedResponse of ClassroomResponse
            deactivate Service
            Endpoint-->>UI: 3.10 200 OK (PagedResponse of ClassroomResponse)
        end
    end
    deactivate Endpoint
    deactivate UI
