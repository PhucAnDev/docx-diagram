%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title PUT /api/classrooms/{id}
    actor Admin as Admin
    participant UI as UpdateClassroomUI
    participant Endpoint as :ClassroomsController
    participant Service as :ClassroomService
    participant DB as :UnitOfWork
    participant Database as :Database

    Admin->>UI: 1.1 Chỉnh sửa thông tin lớp học và nhấn Lưu
    activate UI
    UI->>Endpoint: 2.1 PUT /api/classrooms/{id} (UpdateClassroomRequest)
    activate Endpoint

    alt ModelState.IsValid == false
        Endpoint-->>UI: 2.2 400 Bad Request
    else ModelState.IsValid == true
        Endpoint->>Service: 3.1 UpdateClassroomAsync(id, request)
        activate Service

        Service->>DB: 3.2 ClassroomRepository.GetFirstOrDefaultAsync(c => c.Id == id && !c.IsDeleted, includeProperties: "Enrollments")
        activate DB
        DB->>Database: 3.3 Execute SELECT query
        activate Database
        Database-->>DB: 3.4 Classroom entity or null
        deactivate Database
        deactivate DB

        alt Classroom not found (classroom == null)
            Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
            Endpoint-->>UI: 3.5.2 404 Not Found (Classroom not found.)
        else Classroom exists
            alt StartDate >= EndDate
                Service-->>Endpoint: 3.6.1 (Succeeded = false, Error = "Ngày bắt đầu phải trước ngày kết thúc...")
                Endpoint-->>UI: 3.6.2 400 Bad Request (Ngày bắt đầu phải trước ngày kết thúc...)
            else StartDate < EndDate
                Service->>DB: 3.7 UserRepository.GetFirstOrDefaultAsync(u => u.Id == request.UserId && !u.IsDeleted && u.IsActive && u.Role.RoleName == UserRole.Teacher, includeProperties: "Role")
                activate DB
                DB->>Database: 3.8 Execute SELECT query
                activate Database
                Database-->>DB: 3.9 Teacher entity or null
                deactivate Database
                deactivate DB

                alt Teacher not found or inactive
                    Service-->>Endpoint: 3.10.1 (Succeeded = false, Error = "Không tìm thấy giáo viên...")
                    Endpoint-->>UI: 3.10.2 400 Bad Request (Không tìm thấy giáo viên...)
                else Teacher valid
                    Service->>DB: 3.11 ProgramRepository.GetFirstOrDefaultAsync(p => p.Id == request.ProgramId && !p.IsDeleted && p.Status == "Active")
                    activate DB
                    DB->>Database: 3.12 Execute SELECT query
                    activate Database
                    Database-->>DB: 3.13 Program entity or null
                    deactivate Database
                    deactivate DB

                    alt Program not found or inactive
                        Service-->>Endpoint: 3.14.1 (Succeeded = false, Error = "Không tìm thấy chương trình học...")
                        Endpoint-->>UI: 3.14.2 400 Bad Request (Không tìm thấy chương trình học...)
                    else Program valid
                        Service->>DB: 3.15 SemesterRepository.GetFirstOrDefaultAsync(s => s.Id == request.SemesterId && !s.IsDeleted)
                        activate DB
                        DB->>Database: 3.16 Execute SELECT query
                        activate Database
                        Database-->>DB: 3.17 Semester entity or null
                        deactivate Database
                        deactivate DB

                        alt Semester not found
                            Service-->>Endpoint: 3.18.1 (Succeeded = false, Error = "Không tìm thấy học kỳ liên kết.")
                            Endpoint-->>UI: 3.18.2 400 Bad Request (Không tìm thấy học kỳ liên kết.)
                        else Semester valid
                            alt Date outside semester bounds
                                Service-->>Endpoint: 3.19.1 (Succeeded = false, Error = "Thời gian lớp học phải nằm trong học kỳ.")
                                Endpoint-->>UI: 3.19.2 400 Bad Request (Thời gian lớp học...)
                            else Dates valid
                                note over Service: Update classroom fields<br/>classroom.UpdatedAt = DateTime.UtcNow
                                
                                Service->>DB: 3.20 SaveChangesAsync()
                                activate DB
                                DB->>Database: 3.21 Execute UPDATE query
                                activate Database
                                Database-->>DB: 3.22 Rows affected
                                deactivate Database
                                deactivate DB

                                Service->>DB: 3.23 ClassroomRepository.GetFirstOrDefaultAsync(c => c.Id == id, includeProperties: "User,User.Role,Program,Semester,Enrollments")
                                activate DB
                                DB->>Database: 3.24 Execute SELECT with includes
                                activate Database
                                Database-->>DB: 3.25 Updated Classroom entity
                                deactivate Database
                                deactivate DB

                                Service-->>Endpoint: 3.26 (Succeeded = true, ClassroomResponse)
                                deactivate Service
                                Endpoint-->>UI: 3.27 200 OK (ClassroomResponse)
                            end
                        end
                    end
                end
            end
        end
    end
    deactivate Endpoint
    deactivate UI
