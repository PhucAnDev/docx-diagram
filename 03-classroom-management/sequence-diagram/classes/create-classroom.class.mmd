classDiagram
    direction TB

    class ClassroomsController {
        -classroomService: IClassroomService
        +Create(request: CreateClassroomRequest) Task~ActionResult~
    }

    class CreateClassroomRequest {
        +UserId: int
        +ProgramId: int
        +SemesterId: int
        +ClassName: string
        +Description: string
        +StartDate: DateTime
        +EndDate: DateTime
        +Status: string
    }

    class IClassroomService {
        <<interface>>
        +CreateClassroomAsync(request: CreateClassroomRequest) Task~Tuple~bool,IEnumerable~string~,ClassroomResponse~~~~
    }

    class ClassroomService {
        -unitOfWork: IUnitOfWork
        -mapper: IMapper
        +CreateClassroomAsync(request: CreateClassroomRequest) Task~Tuple~bool,IEnumerable~string~,ClassroomResponse~~~~
    }

    class IUnitOfWork {
        <<interface>>
        +ClassroomRepository: IClassroomRepository
        +UserRepository: IUserRepository
        +ProgramRepository: IProgramRepository
        +SemesterRepository: ISesterRepository
        +SaveChangesAsync() Task~int~
    }

    class UnitOfWork {
        -context: AppDbContext
        +ClassroomRepository: IClassroomRepository
        +UserRepository: IUserRepository
        +ProgramRepository: IProgramRepository
        +SemesterRepository: ISesterRepository
        +SaveChangesAsync() Task~int~
    }

    class ClassroomResponse {
        +Id: int
        +ClassName: string
        +Description: string
        +StartDate: DateTime
        +EndDate: DateTime
        +Status: string
        +TeacherName: string
        +ProgramName: string
        +SemesterName: string
    }

    class Classroom {
        +ClassName: string
        +Description: string
        +StartDate: DateTime
        +EndDate: DateTime
        +Status: string
        +UserId: int
        +ProgramId: int
        +SemesterId: int
    }

    class User {
        +FullName: string
        +IsDeleted: bool
        +IsActive: bool
    }

    class Program {
        +ProgramName: string
        +Status: string
        +IsDeleted: bool
    }

    class Semester {
        +SemesterName: string
        +StartDate: DateTime
        +EndDate: DateTime
        +IsDeleted: bool
    }

