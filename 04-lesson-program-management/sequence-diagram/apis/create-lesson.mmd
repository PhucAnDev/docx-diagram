sequenceDiagram
    title POST /api/Lessons
    actor Admin as User (Admin/Teacher)
    participant UI as CreateLessonUI
    participant Endpoint as :LessonsController
    participant Service as :LessonService
    participant DB as :UnitOfWork
    participant Database as :Database

    Admin->>UI: 1.1 Nhập thông tin bài học mới (ProgramId, tên, thứ tự, kỹ năng, thời gian...)
    activate UI
    UI->>Endpoint: 2.1 POST /api/Lessons (CreateLessonRequest)
    activate Endpoint

    Endpoint->>Service: 3.1 CreateLessonAsync(request)
    activate Service

    Service->>DB: 3.2 Repository<Program>().GetFirstOrDefaultAsync(filter: p => p.Id == request.ProgramId && !p.IsDeleted, tracked: false)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 Program entity or null
    deactivate Database
    deactivate DB

    alt Program not found
        Service-->>Endpoint: 3.5.1 (Succeeded = false, Error = "Program not found.")
        deactivate Service
        Endpoint-->>UI: 3.5.2 400 Bad Request (Create lesson failed.)
    else Program exists
        activate Service
        note over Service: Create Lesson entity
        
        Service->>DB: 3.6 LessonRepository.AddAsync(lesson)
        activate DB
        DB-->>Service: 3.7 Success
        deactivate DB

        Service->>DB: 3.8 SaveChangesAsync()
        activate DB
        DB->>Database: 3.9 Execute INSERT query
        activate Database
        Database-->>DB: 3.10 Rows affected
        deactivate Database
        deactivate DB

        Service-->>Endpoint: 3.11 (Succeeded = true, LessonResponse)
        deactivate Service
        Endpoint-->>UI: 3.12 200 OK (Lesson created.)
    end
    deactivate Endpoint
    deactivate UI
