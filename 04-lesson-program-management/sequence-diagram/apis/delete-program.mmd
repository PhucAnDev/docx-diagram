%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title DELETE /api/programs/{id}
    actor Admin as Admin
    participant UI as DeleteProgramUI
    participant Endpoint as :ProgramsController
    participant Service as :ProgramService
    participant DB as :UnitOfWork
    participant Database as :Database

    Admin->>UI: 1.1 Yêu cầu xóa chương trình học
    activate UI
    UI->>Endpoint: 2.1 DELETE /api/programs/{id}
    activate Endpoint

    Endpoint->>Service: 3.1 DeleteProgramAsync(id)
    activate Service

    Service->>DB: 3.2 ProgramRepository.GetFirstOrDefaultAsync(p => p.Id == id && !p.IsDeleted)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 Program entity or null
    deactivate Database
    deactivate DB

    alt Program not found
        Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
        Endpoint-->>UI: 3.5.2 404 Not Found (Program not found.)
    else Program exists
        note over Service: program.IsDeleted = true<br/>program.DeletedAt = DateTime.UtcNow<br/>program.UpdatedAt = DateTime.UtcNow

        Service->>DB: 3.6 SaveChangesAsync()
        activate DB
        DB->>Database: 3.7 Execute UPDATE query
        activate Database
        Database-->>DB: 3.8 Rows affected
        deactivate Database
        deactivate DB

        Service-->>Endpoint: 3.9 (Succeeded = true)
        deactivate Service
        Endpoint-->>UI: 3.10 200 OK (Program deleted successfully.)
    end
    deactivate Endpoint
    deactivate UI
