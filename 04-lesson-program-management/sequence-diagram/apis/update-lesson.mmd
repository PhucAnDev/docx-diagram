%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title PUT /api/lessons/{id}
    actor Admin as User (Admin/Teacher)
    participant UI as UpdateLessonUI
    participant Endpoint as :LessonsController
    participant Service as :LessonService
    participant DB as :UnitOfWork
    participant Database as :Database

    Admin->>UI: 1.1 Chỉnh sửa thông tin bài học và nhấn Lưu
    activate UI
    UI->>Endpoint: 2.1 PUT /api/lessons/{id} (UpdateLessonRequest)
    activate Endpoint

    alt ModelState.IsValid == false
        Endpoint-->>UI: 2.2 400 Bad Request
    else ModelState.IsValid == true
        Endpoint->>Service: 3.1 UpdateLessonAsync(id, request)
        activate Service

        Service->>DB: 3.2 LessonRepository.GetFirstOrDefaultAsync(l => l.Id == id && !l.IsDeleted)
        activate DB
        DB->>Database: 3.3 Execute SELECT query
        activate Database
        Database-->>DB: 3.4 Lesson entity or null
        deactivate Database
        deactivate DB

        alt Lesson not found
            Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
            Endpoint-->>UI: 3.5.2 404 Not Found (Lesson not found.)
        else Lesson exists
            note over Service: Update lesson fields<br/>lesson.UpdatedAt = DateTime.UtcNow
            
            Service->>DB: 3.6 SaveChangesAsync()
            activate DB
            DB->>Database: 3.7 Execute UPDATE query
            activate Database
            Database-->>DB: 3.8 Rows affected
            deactivate Database
            deactivate DB

            Service-->>Endpoint: 3.9 (Succeeded = true, LessonResponse)
            deactivate Service
            Endpoint-->>UI: 3.10 200 OK (LessonResponse)
        end
    end
    deactivate Endpoint
    deactivate UI
