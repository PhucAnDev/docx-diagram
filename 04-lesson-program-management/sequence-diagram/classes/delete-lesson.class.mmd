        +DeleteLessonAsync(id: int) Task~Tuple~bool,bool,IEnumerable~string~~~~
    }

    class IUnitOfWork {
        <<interface>>
        +LessonRepository: ILessonRepository
        +SaveChangesAsync() Task~int~
    }

    class UnitOfWork {
        -context: AppDbContext
        +LessonRepository: ILessonRepository
        +SaveChangesAsync() Task~int~
    }

    class Lesson {
        +IsDeleted: bool
