classDiagram
    direction TB

    class LessonsController {
        -lessonService: ILessonService
        +Update(id: int, request: UpdateLessonRequest) Task~ActionResult~
    }

    class UpdateLessonRequest {
        +LessonName: string
        +LessonOrder: int
        +Description: string
        +TargetSkill: string
        +EstimatedDuration: int
        +Status: string
        +MaxScore: float
    }

    class ILessonService {
        <<interface>>
        +UpdateLessonAsync(id: int, request: UpdateLessonRequest) Task~Tuple~bool,bool,IEnumerable~string~,LessonResponse~~~~
    }

    class LessonService {
        -unitOfWork: IUnitOfWork
        -mapper: IMapper
        +UpdateLessonAsync(id: int, request: UpdateLessonRequest) Task~Tuple~bool,bool,IEnumerable~string~,LessonResponse~~~~
    }

    class IUnitOfWork {
        <<interface>>
        +LessonRepository: ILessonRepository
        +SaveChangesAsync() Task~int~
    }

    class UnitOfWork {
        -context: AppDbContext
        +LessonRepository: ILessonRepository
        +SaveChangesAsync() Task~int~
    }

    class LessonResponse {
        +Id: int
        +ProgramId: int
        +LessonName: string
        +LessonOrder: int
        +Description: string
        +TargetSkill: string
        +EstimatedDuration: int
        +Status: string
        +MaxScore: float
    }

    class Lesson {
        +ProgramId: int
        +LessonName: string
        +LessonOrder: int
        +Description: string
        +TargetSkill: string
        +EstimatedDuration: int
        +Status: string
        +MaxScore: float
    }

    LessonsController ..> UpdateLessonRequest : uses
    LessonsController ..> ILessonService : uses
    ILessonService <.. LessonService : implements
    LessonService ..> IUnitOfWork : uses
    LessonService ..> LessonResponse : uses
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> Lesson : uses
