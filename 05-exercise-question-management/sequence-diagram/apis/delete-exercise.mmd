%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title DELETE /api/exercises/{id}
    actor TeacherUser as Teacher/Admin
    participant UI as DeleteExerciseUI
    participant Endpoint as :ExercisesController
    participant Service as :ExerciseService
    participant DB as :UnitOfWork
    participant Database as :Database

    TeacherUser->>UI: 1.1 Yêu cầu xóa bài tập
    activate UI
    UI->>Endpoint: 2.1 DELETE /api/exercises/{id}
    activate Endpoint

    alt id <= 0
        Endpoint-->>UI: 2.2 400 Bad Request (Invalid id.)
    else id > 0
        Endpoint->>Service: 3.1 DeleteAsync(id)
        activate Service

        Service->>DB: 3.2 ExerciseRepository.GetFirstOrDefaultAsync(e => e.Id == id && !e.IsDeleted, includeProperties: "Results")
        activate DB
        DB->>Database: 3.3 Execute SELECT query
        activate Database
        Database-->>DB: 3.4 Exercise entity or null
        deactivate Database
        deactivate DB

        alt Exercise not found
            Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
            deactivate Service
            Endpoint-->>UI: 3.5.2 404 Not Found (Exercise not found.)
        else Exercise exists
            activate Service
            alt Has historical Results (BR-72)
                Service-->>Endpoint: 3.6.1 (Succeeded = false, Error = "Không thể xóa bài tập đã có lịch sử kết quả...")
                deactivate Service
                Endpoint-->>UI: 3.6.2 400 Bad Request (Delete failed.)
            else No results exist
                activate Service
                note over Service: entity.IsDeleted = true<br/>entity.DeletedAt = DateTime.UtcNow<br/>entity.UpdatedAt = DateTime.UtcNow

                Service->>DB: 3.7 SaveChangesAsync()
                activate DB
                DB->>Database: 3.8 Execute UPDATE query
                activate Database
                Database-->>DB: 3.9 Rows affected
                deactivate Database
                deactivate DB

                Service-->>Endpoint: 3.10 (Succeeded = true)
                deactivate Service
                Endpoint-->>UI: 3.11 200 OK (Exercise deleted.)
            end
        end
    end
    deactivate Endpoint
    deactivate UI
