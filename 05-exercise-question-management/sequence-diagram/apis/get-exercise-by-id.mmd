sequenceDiagram
    title GET /api/exercises/{id}
    actor User as User (Admin/Teacher/Parent/Child)
    participant UI as GetExerciseByIdUI
    participant Endpoint as :ExercisesController
    participant Service as :ExerciseService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu hiển thị chi tiết bài tập
    activate UI
    UI->>Endpoint: 2.1 GET /api/exercises/{id}
    activate Endpoint

    Endpoint->>Service: 3.1 GetByIdAsync(id)
    activate Service

    Service->>DB: 3.2 ExerciseRepository.GetFirstOrDefaultAsync(e => e.Id == id && !e.IsDeleted, includeProperties: "Teacher,Lesson,Lesson.Program,ExerciseType,ExerciseQuestions", tracked: false)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 Exercise entity with details or null
    deactivate Database
    deactivate DB

    alt Exercise not found
        Service-->>Endpoint: 3.5.1 null
        Endpoint-->>UI: 3.5.2 404 Not Found (Exercise not found.)
    else Exercise exists
        Service-->>Endpoint: 3.6.1 ExerciseResponse
        deactivate Service
        Endpoint-->>UI: 3.6.2 200 OK (ExerciseResponse)
    end
    deactivate Endpoint
    deactivate UI
