sequenceDiagram
    title GET /api/exercise-types/{id}
    actor User as User (Admin/Teacher/Parent)
    participant UI as GetExerciseTypeByIdUI
    participant Endpoint as :ExerciseTypesController
    participant Service as :ExerciseTypeService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu hiển thị chi tiết loại bài tập
    activate UI
    UI->>Endpoint: 2.1 GET /api/exercise-types/{id}
    activate Endpoint

    Endpoint->>Service: 3.1 GetByIdAsync(id)
    activate Service

    Service->>DB: 3.2 ExerciseTypeRepository.GetFirstOrDefaultAsync(t => t.Id == id && !t.IsDeleted, tracked: false)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 ExerciseType entity or null
    deactivate Database
    deactivate DB

    alt ExerciseType not found
        Service-->>Endpoint: 3.5.1 null
        Endpoint-->>UI: 3.5.2 404 Not Found (ExerciseType not found.)
    else ExerciseType exists
        Service-->>Endpoint: 3.6.1 ExerciseTypeResponse
        deactivate Service
        Endpoint-->>UI: 3.6.2 200 OK (ExerciseTypeResponse)
    end
    deactivate Endpoint
    deactivate UI
