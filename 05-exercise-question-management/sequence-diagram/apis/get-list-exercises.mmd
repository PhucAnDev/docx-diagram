sequenceDiagram
    title GET /api/exercises
    actor User as User (Admin/Teacher/Parent)
    participant UI as GetListExercisesUI
    participant Endpoint as :ExercisesController
    participant Service as :ExerciseService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu hiển thị danh sách bài tập
    activate UI
    UI->>Endpoint: 2.1 GET /api/exercises (pageNumber, pageSize, lessonId, typeId, teacherId, status)
    activate Endpoint

    Endpoint->>Service: 3.1 GetListAsync(pageNumber, pageSize, lessonId, typeId, teacherId, status)
    activate Service

    Service->>DB: 3.2 ExerciseRepository.GetPagedAsync(...)
    activate DB
    DB->>Database: 3.3 Execute SELECT query with filters & pagination
    activate Database
    Database-->>DB: 3.4 Paged list of Exercises
    deactivate Database
    deactivate DB

    Service-->>Endpoint: 3.5 PagedResponse of ExerciseResponse
    deactivate Service
    Endpoint-->>UI: 3.6 200 OK (PagedResponse of ExerciseResponse)
    deactivate Endpoint
    deactivate UI
