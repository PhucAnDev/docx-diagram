sequenceDiagram
    title GET /api/exercise-questions/{id}
    actor User as User (Admin/Teacher/Parent)
    participant UI as GetQuestionByIdUI
    participant Endpoint as :ExerciseQuestionsController
    participant Service as :ExerciseQuestionService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu hiển thị chi tiết câu hỏi
    activate UI
    UI->>Endpoint: 2.1 GET /api/exercise-questions/{id}
    activate Endpoint

    Endpoint->>Service: 3.1 GetByIdAsync(id)
    activate Service

    Service->>DB: 3.2 ExerciseQuestionRepository.GetFirstOrDefaultAsync(q => q.Id == id && !q.IsDeleted, includeProperties: "Exercise,Teacher", tracked: false)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 ExerciseQuestion entity or null
    deactivate Database
    deactivate DB

    alt Question not found
        Service-->>Endpoint: 3.5.1 null
        Endpoint-->>UI: 3.5.2 404 Not Found (Question not found.)
    else Question exists
        Service-->>Endpoint: 3.6.1 ExerciseQuestionResponse
        deactivate Service
        Endpoint-->>UI: 3.6.2 200 OK (ExerciseQuestionResponse)
    end
    deactivate Endpoint
    deactivate UI
