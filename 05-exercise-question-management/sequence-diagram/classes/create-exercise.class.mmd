classDiagram
    direction TB

    class ExercisesController {
        -exerciseService: IExerciseService
        +Create(request: CreateExerciseRequest) Task~ActionResult~
    }

    class CreateExerciseRequest {
        +TeacherId: int
        +LessonId: int
        +TypeId: int
        +ExerciseName: string
        +Instruction: string
        +DifficultyLevel: string
        +TargetSkill: string
        +Language: string
        +DurationLimit: int
        +Status: string
    }

    class IExerciseService {
        <<interface>>
        +CreateAsync(request: CreateExerciseRequest) Task~Tuple~bool,IEnumerable~string~,ExerciseResponse~~~~
    }

    class ExerciseService {
        -unitOfWork: IUnitOfWork
        -mapper: IMapper
        +CreateAsync(request: CreateExerciseRequest) Task~Tuple~bool,IEnumerable~string~,ExerciseResponse~~~~
    }

    class IUnitOfWork {
        <<interface>>
        +ExerciseRepository: IExerciseRepository
        +UserRepository: IUserRepository
        +LessonRepository: ILessonRepository
        +ExerciseTypeRepository: IExerciseTypeRepository
        +SaveChangesAsync() Task~int~
    }

    class UnitOfWork {
        -context: AppDbContext
        +ExerciseRepository: IExerciseRepository
        +UserRepository: IUserRepository
        +LessonRepository: ILessonRepository
        +ExerciseTypeRepository: IExerciseTypeRepository
        +SaveChangesAsync() Task~int~
    }

    class ExerciseResponse {
        +Id: int
        +ExerciseName: string
        +Instruction: string
        +DifficultyLevel: string
        +TargetSkill: string
        +Language: string
        +DurationLimit: int
        +Status: string
    }

    class Exercise {
        +ExerciseName: string
        +Instruction: string
        +DifficultyLevel: string
        +TargetSkill: string
        +Language: string
        +DurationLimit: int
        +Status: string
        +TeacherId: int
        +LessonId: int
        +TypeId: int
    }

    class User {
        +FullName: string
        +IsDeleted: bool
        +IsActive: bool
    }

    class Lesson {
        +LessonName: string
        +Status: string
        +IsDeleted: bool
        +Program: Program
    }

    class Program {
        +ProgramName: string
        +Status: string
        +IsDeleted: bool
    }

    class ExerciseType {
        +TypeName: string
        +IsActive: bool
        +IsDeleted: bool
    }

