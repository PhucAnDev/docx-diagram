classDiagram
    direction TB

    class ExerciseTypesController {
        -typeService: IExerciseTypeService
        +GetById(id: int) Task~ActionResult~
    }

    class IExerciseTypeService {
        <<interface>>
        +GetByIdAsync(id: int) Task~ExerciseTypeResponse~
    }

    class ExerciseTypeService {
        -unitOfWork: IUnitOfWork
        +GetByIdAsync(id: int) Task~ExerciseTypeResponse~
    }

    class IUnitOfWork {
        <<interface>>
        +ExerciseTypeRepository: IExerciseTypeRepository
    }

    class UnitOfWork {
        -context: AppDbContext
        +ExerciseTypeRepository: IExerciseTypeRepository
    }

    class ExerciseTypeResponse {
        +Id: int
        +TypeName: string
        +Description: string
        +IsActive: bool
        +CreatedAt: DateTime
    }

    class ExerciseType {
        +TypeName: string
        +Description: string
        +IsActive: bool
    }

    ExerciseTypesController ..> IExerciseTypeService : uses
    IExerciseTypeService <.. ExerciseTypeService : implements
    ExerciseTypeService ..> IUnitOfWork : uses
    ExerciseTypeService ..> ExerciseTypeResponse : uses
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> ExerciseType : uses
