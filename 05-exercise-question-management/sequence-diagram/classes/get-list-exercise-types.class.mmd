classDiagram
    direction TB

    class ExerciseTypesController {
        -typeService: IExerciseTypeService
        +GetList(pageNumber: int, pageSize: int, isActive: bool?) Task~ActionResult~
    }

    class IExerciseTypeService {
        <<interface>>
        +GetListAsync(pageNumber: int, pageSize: int, isActive: bool?) Task~PagedResponse~ExerciseTypeResponse~~
    }

    class ExerciseTypeService {
        -unitOfWork: IUnitOfWork
        +GetListAsync(pageNumber: int, pageSize: int, isActive: bool?) Task~PagedResponse~ExerciseTypeResponse~~
    }

    class IUnitOfWork {
        <<interface>>
        +ExerciseTypeRepository: IExerciseTypeRepository
    }

    class UnitOfWork {
        -context: AppDbContext
        +ExerciseTypeRepository: IExerciseTypeRepository
    }

    class ExerciseTypeResponse {
        +Id: int
        +TypeName: string
        +Description: string
        +IsActive: bool
        +CreatedAt: DateTime
    }

    class PagedResponse~T~ {
        +PageNumber: int
        +PageSize: int
        +TotalCount: int
        +TotalPages: int
        +Items: List~T~
    }

    class ExerciseType {
        +TypeName: string
        +Description: string
        +IsActive: bool
    }

    ExerciseTypesController ..> IExerciseTypeService : uses
    IExerciseTypeService <.. ExerciseTypeService : implements
    ExerciseTypeService ..> IUnitOfWork : uses
    ExerciseTypeService ..> PagedResponse~ExerciseTypeResponse~ : uses
    PagedResponse~ExerciseTypeResponse~ ..> ExerciseTypeResponse : wraps
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> ExerciseType : uses
