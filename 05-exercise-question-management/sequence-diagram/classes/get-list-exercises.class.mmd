classDiagram
    direction TB

    class ExercisesController {
        -exerciseService: IExerciseService
        +GetList(pageNumber: int, pageSize: int, lessonId: int?, typeId: int?, teacherId: int?, status: string?) Task~ActionResult~
    }

    class IExerciseService {
        <<interface>>
        +GetListAsync(pageNumber: int, pageSize: int, lessonId: int?, typeId: int?, teacherId: int?, status: string?) Task~PagedResponse~ExerciseResponse~~
    }

    class ExerciseService {
        -unitOfWork: IUnitOfWork
        +GetListAsync(pageNumber: int, pageSize: int, lessonId: int?, typeId: int?, teacherId: int?, status: string?) Task~PagedResponse~ExerciseResponse~~
    }

    class IUnitOfWork {
        <<interface>>
        +ExerciseRepository: IExerciseRepository
    }

    class UnitOfWork {
        -context: AppDbContext
        +ExerciseRepository: IExerciseRepository
    }

    class ExerciseResponse {
        +Id: int
        +ExerciseName: string
        +Instruction: string
        +DifficultyLevel: string
        +TargetSkill: string
        +Language: string
        +DurationLimit: int
        +Status: string
        +TeacherName: string
        +LessonName: string
        +ProgramName: string
        +TypeName: string
        +QuestionsCount: int
    }

    class PagedResponse~T~ {
        +PageNumber: int
        +PageSize: int
        +TotalCount: int
        +TotalPages: int
        +Items: List~T~
    }

    class Exercise {
        +ExerciseName: string
        +Instruction: string
        +DifficultyLevel: string
        +TargetSkill: string
        +Language: string
        +DurationLimit: int
        +Status: string
        +TeacherId: int
        +LessonId: int
        +TypeId: int
    }

    class User {
        +FullName: string
    }

    class Lesson {
        +LessonName: string
    }

    class Program {
        +ProgramName: string
    }

    class ExerciseType {
        +TypeName: string
    }

    ExercisesController ..> IExerciseService : uses
    IExerciseService <.. ExerciseService : implements
    ExerciseService ..> IUnitOfWork : uses
    ExerciseService ..> PagedResponse~ExerciseResponse~ : uses
    PagedResponse~ExerciseResponse~ ..> ExerciseResponse : wraps
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> Exercise : uses
    Exercise ..> User : uses
    Exercise ..> Lesson : uses
    Lesson ..> Program : uses
    Exercise ..> ExerciseType : uses
