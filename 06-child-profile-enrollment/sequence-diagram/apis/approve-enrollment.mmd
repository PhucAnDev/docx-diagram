%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title PUT /api/Enrollments/{id}/approve
    actor User as User (Admin/Teacher)
    participant UI as ApproveEnrollmentUI
    participant Endpoint as :EnrollmentsController
    participant Service as :EnrollmentService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Nhấp Duyệt ghi danh cho trẻ
    activate UI
    UI->>Endpoint: 2.1 PUT /api/Enrollments/{id}/approve
    activate Endpoint

    Endpoint->>Service: 3.1 ApproveEnrollmentAsync(id, requesterId, requesterRole)
    activate Service

    Service->>DB: 3.2 EnrollmentRepository.GetByIdWithDetailsAsync(id)
    activate DB
    DB->>Database: 3.3 Execute SELECT with includes
    activate Database
    Database-->>DB: 3.4 Enrollment entity with details or null
    deactivate Database
    deactivate DB

    alt Enrollment not found (entity == null)
        Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
        Endpoint-->>UI: 3.5.2 404 Not Found (Enrollment not found.)
    else Enrollment exists
        alt Enrollment.Status != "Pending"
            Service-->>Endpoint: 3.6.1 (Succeeded = false, Error = "Chỉ có thể duyệt ghi danh đang ở trạng thái Chờ duyệt.")
            Endpoint-->>UI: 3.6.2 400 Bad Request (Chỉ có thể duyệt...)
        else Enrollment is Pending
            alt requesterRole == "Teacher" && entity.Classroom.UserId != requesterId
                Service-->>Endpoint: 3.7.1 (Succeeded = false, Error = "Giáo viên chỉ có thể duyệt ghi danh trong lớp học của mình.")
                Endpoint-->>UI: 3.7.2 400 Bad Request (Giáo viên chỉ có thể...)
            else Valid authorization to approve
                note over Service: entity.Status = "Active", entity.UpdatedAt = DateTime.UtcNow
                
                Service->>DB: 3.8 EnrollmentRepository.Update(entity)
                activate DB
                DB-->>Service: 3.9 Success
                deactivate DB

                Service->>DB: 3.10 SaveChangesAsync()
                activate DB
                DB->>Database: 3.11 Execute UPDATE query
                activate Database
                Database-->>DB: 3.12 Rows affected
                deactivate Database
                deactivate DB

                Service->>DB: 3.13 EnrollmentRepository.GetByIdWithDetailsAsync(entity.Id)
                activate DB
                DB->>Database: 3.14 Execute SELECT with includes
                activate Database
                Database-->>DB: 3.15 Updated Enrollment entity with details
                deactivate Database
                deactivate DB

                Service-->>Endpoint: 3.16 (Succeeded = true, EnrollmentResponse)
                deactivate Service
                Endpoint-->>UI: 3.17 200 OK (EnrollmentResponse)
            end
        end
    end
    deactivate Endpoint
    deactivate UI
