%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title POST /api/Enrollments
    actor User as User (Admin/Teacher)
    participant UI as CreateEnrollmentUI
    participant Endpoint as :EnrollmentsController
    participant Service as :EnrollmentService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Chọn bé, chọn lớp, ngày và gửi yêu cầu ghi danh
    activate UI
    UI->>Endpoint: 2.1 POST /api/Enrollments (CreateEnrollmentRequest)
    activate Endpoint

    alt ModelState.IsValid == false
        Endpoint-->>UI: 2.2 400 Bad Request
    else ModelState.IsValid == true
        Endpoint->>Service: 3.1 CreateEnrollmentAsync(request, requesterId, requesterRole)
        activate Service

        alt Status is invalid (!["Active", "Pending", "Completed", "Cancelled"].Contains(request.Status))
            Service-->>Endpoint: 3.2.1 (Succeeded = false, Error = "Trạng thái không hợp lệ.")
            Endpoint-->>UI: 3.2.2 400 Bad Request (Trạng thái không hợp lệ.)
        else Status is valid
            Service->>DB: 3.3 ChildProfileRepository.GetFirstOrDefaultAsync(c => c.Id == ChildId && !c.IsDeleted)
            activate DB
            DB->>Database: 3.4 Execute SELECT query
            activate Database
            Database-->>DB: 3.5 ChildProfile entity or null
            deactivate Database
            deactivate DB

            alt Child does not exist
                Service-->>Endpoint: 3.6.1 (Succeeded = false, Error = "Hồ sơ trẻ không tồn tại.")
                Endpoint-->>UI: 3.6.2 400 Bad Request (Hồ sơ trẻ không tồn tại.)
            else Child exists
                Service->>DB: 3.7 ClassroomRepository.GetFirstOrDefaultAsync(c => c.Id == ClassId && !c.IsDeleted)
                activate DB
                DB->>Database: 3.8 Execute SELECT query
                activate Database
                Database-->>DB: 3.9 Classroom entity or null
                deactivate Database
                deactivate DB

                alt Classroom does not exist or classroom.Status != "Active"
                    Service-->>Endpoint: 3.10.1 (Succeeded = false, Error = "Lớp học không tồn tại/không hoạt động.")
                    Endpoint-->>UI: 3.10.2 400 Bad Request (Lớp học không tồn tại/không hoạt động.)
                else Classroom exists and active
                    alt requesterRole == "Teacher" && classroom.UserId != requesterId
                        Service-->>Endpoint: 3.11.1 (Succeeded = false, Error = "Giáo viên chỉ có thể ghi danh vào lớp của mình.")
                        Endpoint-->>UI: 3.11.2 400 Bad Request (Giáo viên chỉ có thể ghi danh vào lớp của mình.)
                    else Valid classroom for requester
                        Service->>DB: 3.12 EnrollmentRepository.HasActiveEnrollmentAsync(ChildId, ClassId)
                        activate DB
                        DB->>Database: 3.13 Execute SELECT query
                        activate Database
                        Database-->>DB: 3.14 Boolean duplicate result
                        deactivate Database
                        deactivate DB

                        alt Duplicate active enrollment exists
                            Service-->>Endpoint: 3.15.1 (Succeeded = false, Error = "Trẻ đã có ghi danh Active trong lớp học này.")
                            Endpoint-->>UI: 3.15.2 400 Bad Request (Trẻ đã có ghi danh Active trong lớp học này.)
                        else Unique enrollment
                            Service->>DB: 3.16 EnrollmentRepository.AddAsync(entity)
                            activate DB
                            DB-->>Service: 3.17 Success
                            deactivate DB

                            Service->>DB: 3.18 SaveChangesAsync()
                            activate DB
                            DB->>Database: 3.19 Execute INSERT query
                            activate Database
                            Database-->>DB: 3.20 Rows affected
                            deactivate Database
                            deactivate DB

                            Service->>DB: 3.21 EnrollmentRepository.GetByIdWithDetailsAsync(entity.Id)
                            activate DB
                            DB->>Database: 3.22 Execute SELECT with includes
                            activate Database
                            Database-->>DB: 3.23 Enrollment entity with details
                            deactivate Database
                            deactivate DB

                            Service-->>Endpoint: 3.24 (Succeeded = true, EnrollmentResponse)
                            deactivate Service
                            Endpoint-->>UI: 3.25 200 OK (EnrollmentResponse)
                        end
                    end
                end
            end
        end
    end
    deactivate Endpoint
    deactivate UI
