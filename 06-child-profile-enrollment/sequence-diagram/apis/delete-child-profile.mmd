sequenceDiagram
    title DELETE /api/child-profiles/{id}
    actor User as User (Admin)
    participant UI as DeleteChildProfileUI
    participant Endpoint as :ChildProfilesController
    participant Service as :ChildProfileService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu xóa hồ sơ trẻ
    activate UI
    UI->>Endpoint: 2.1 DELETE /api/child-profiles/{id}
    activate Endpoint

    Endpoint->>Service: 3.1 DeleteChildProfileAsync(id)
    activate Service

    Service->>DB: 3.2 ChildProfileRepository.GetFirstOrDefaultAsync(c => c.Id == id && !c.IsDeleted)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 ChildProfile entity or null
    deactivate Database
    deactivate DB

    alt ChildProfile not found
        Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
        Endpoint-->>UI: 3.5.2 404 Not Found (Không tìm thấy hồ sơ trẻ.)
    else ChildProfile exists
        note over Service: childProfile.IsDeleted = true<br/>childProfile.DeletedAt = DateTime.UtcNow<br/>childProfile.UpdatedAt = DateTime.UtcNow
        
        Service->>DB: 3.6 ChildProfileRepository.Update(childProfile)
        Service->>DB: 3.7 SaveChangesAsync()
        activate DB
        DB->>Database: 3.8 Execute UPDATE query
        activate Database
        Database-->>DB: 3.9 Rows affected
        deactivate Database
        deactivate DB

        alt Save changes failed
            Service-->>Endpoint: 3.10.1 (Succeeded = false, Error = "Xóa hồ sơ trẻ thất bại.")
            Endpoint-->>UI: 3.10.2 400 Bad Request (Xóa hồ sơ trẻ thất bại.)
        else Save changes success
            Service-->>Endpoint: 3.11.1 (Succeeded = true)
            deactivate Service
            Endpoint-->>UI: 3.11.2 200 OK (Child profile deleted successfully.)
        end
    end
    deactivate Endpoint
    deactivate UI
