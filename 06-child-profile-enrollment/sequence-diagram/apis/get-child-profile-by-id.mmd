sequenceDiagram
    title GET /api/child-profiles/{id}
    actor User as User (Admin/Teacher/Parent)
    participant UI as ChildProfileDetailsUI
    participant Endpoint as :ChildProfilesController
    participant Service as :ChildProfileService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu hiển thị chi tiết hồ sơ trẻ
    activate UI
    UI->>Endpoint: 2.1 GET /api/child-profiles/{id}
    activate Endpoint

    Endpoint->>Service: 3.1 GetChildProfileByIdAsync(id)
    activate Service

    Service->>DB: 3.2 ChildProfileRepository.GetFirstOrDefaultAsync(c => c.Id == id && !c.IsDeleted, tracked: false)
    activate DB
    DB->>Database: 3.3 Execute SELECT query
    activate Database
    Database-->>DB: 3.4 ChildProfile entity or null
    deactivate Database
    deactivate DB

    alt ChildProfile not found
        Service-->>Endpoint: 3.5.1 null
        Endpoint-->>UI: 3.5.2 404 Not Found (Child profile not found.)
    else ChildProfile exists
        Service-->>Endpoint: 3.6.1 ChildProfileResponse
        deactivate Service
        Endpoint-->>UI: 3.6.2 200 OK (ChildProfileResponse)
    end
    deactivate Endpoint
    deactivate UI
