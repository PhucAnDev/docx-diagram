sequenceDiagram
    title GET /api/enrollments/child/{childId}
    actor User as User (Admin/Teacher/Parent)
    participant UI as ChildEnrollmentsUI
    participant Endpoint as :EnrollmentsController
    participant Service as :EnrollmentService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu danh sách ghi danh của trẻ
    activate UI
    UI->>Endpoint: 2.1 GET /api/enrollments/child/{childId}
    activate Endpoint

    Endpoint->>Service: 3.1 GetEnrollmentsByChildIdAsync(childId)
    activate Service

    Service->>DB: 3.2 EnrollmentRepository.GetAllWithDetailsAsync()
    activate DB
    DB->>Database: 3.3 Execute SELECT with details
    activate Database
    Database-->>DB: 3.4 List of Enrollment entities
    deactivate Database
    deactivate DB

    note over Service: Filter list by ChildId in memory: e.ChildId == childId && !e.IsDeleted

    Service-->>Endpoint: 3.5 List of EnrollmentResponse
    deactivate Service
    Endpoint-->>UI: 3.6 200 OK (List of EnrollmentResponse)
    deactivate Endpoint
    deactivate UI
