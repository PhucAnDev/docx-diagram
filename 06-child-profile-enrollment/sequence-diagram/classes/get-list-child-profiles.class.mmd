classDiagram
    direction TB

    class ChildProfilesController {
        -childProfileService: IChildProfileService
        +Get(query: PaginationQuery) Task~ActionResult~
    }

    class IChildProfileService {
        <<interface>>
        +GetListChildProfileAsync(pageNumber: int, pageSize: int) Task~PagedResponse~ChildProfileResponse~~
    }

    class ChildProfileService {
        -unitOfWork: IUnitOfWork
        -mapper: IMapper
        +GetListChildProfileAsync(pageNumber: int, pageSize: int) Task~PagedResponse~ChildProfileResponse~~
    }

    class IUnitOfWork {
        <<interface>>
        +ChildProfileRepository: IChildProfileRepository
    }

    class UnitOfWork {
        -context: AppDbContext
        +ChildProfileRepository: IChildProfileRepository
    }

    class ChildProfileResponse {
        +Id: int
        +UserId: int
        +FullName: string
        +Avatar: string
        +Age: int
        +Gender: string
        +LearningLevel: string
        +Status: string
        +Note: string
    }

    class PagedResponse~T~ {
        +PageNumber: int
        +PageSize: int
        +TotalCount: int
        +TotalPages: int
        +Items: List~T~
    }

    class ChildProfile {
        +UserId: int
        +FullName: string
        +Avatar: string
        +Age: int
        +Gender: string
        +LearningLevel: string
        +Status: string
        +Note: string
    }

    ChildProfilesController ..> IChildProfileService : uses
    IChildProfileService <.. ChildProfileService : implements
    ChildProfileService ..> IUnitOfWork : uses
    ChildProfileService ..> PagedResponse~ChildProfileResponse~ : uses
    PagedResponse~ChildProfileResponse~ ..> ChildProfileResponse : wraps
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> ChildProfile : uses
