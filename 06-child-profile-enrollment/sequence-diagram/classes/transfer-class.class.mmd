classDiagram
    direction TB

    class EnrollmentsController {
        -enrollmentService: IEnrollmentService
        +Transfer(id: int, request: TransferEnrollmentRequest) Task~ActionResult~
    }

    class TransferEnrollmentRequest {
        +NewClassId: int
    }

    class IEnrollmentService {
        <<interface>>
        +TransferEnrollmentAsync(id: int, request: TransferEnrollmentRequest, requesterId: int, requesterRole: string) Task~Tuple~bool,bool,IEnumerable~string~,EnrollmentResponse~~~~
    }

    class EnrollmentService {
        -unitOfWork: IUnitOfWork
        -mapper: IMapper
        +TransferEnrollmentAsync(id: int, request: TransferEnrollmentRequest, requesterId: int, requesterRole: string) Task~Tuple~bool,bool,IEnumerable~string~,EnrollmentResponse~~~~
    }

    class IUnitOfWork {
        <<interface>>
        +EnrollmentRepository: IEnrollmentRepository
        +ClassroomRepository: IClassroomRepository
        +SaveChangesAsync() Task~int~
    }

    class UnitOfWork {
        -context: AppDbContext
        +EnrollmentRepository: IEnrollmentRepository
        +ClassroomRepository: IClassroomRepository
        +SaveChangesAsync() Task~int~
    }

    class EnrollmentResponse {
        +Id: int
        +ChildId: int
        +ClassId: int
        +EnrollmentDate: DateTime
        +Status: string
    }

    class Enrollment {
        +ChildId: int
        +ClassId: int
        +Status: string
        +UpdatedAt: DateTime
    }

    class Classroom {
        +UserId: int
        +Status: string
        +IsDeleted: bool
    }

    EnrollmentsController ..> TransferEnrollmentRequest : uses
    EnrollmentsController ..> IEnrollmentService : uses
    IEnrollmentService <.. EnrollmentService : implements
    EnrollmentService ..> IUnitOfWork : uses
    EnrollmentService ..> EnrollmentResponse : uses
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> Enrollment : uses
    UnitOfWork ..> Classroom : uses
    Enrollment ..> Classroom : uses
