sequenceDiagram
    title POST /api/Files/chunks/assess
    actor User as User (Parent)
    participant UI as Godot Speech Scene
    participant Endpoint as :FilesController
    participant Storage as :MinIOService
    participant Azure as :Azure Speech API
    participant HttpClient as :HttpClient

    User->>UI: 1.1 Hoàn thành phát âm một từ/câu luyện nói
    activate UI
    UI->>Endpoint: 2.1 POST /api/Files/chunks/assess (AssessChunkRequest)
    activate Endpoint

    note over Endpoint: Đọc cấu hình AzureSpeech từ appsettings.json
    
    alt Azure Configuration is missing or mock
        note over Endpoint: Tạo kết quả đánh giá giả lập (Mock Assessment)
        Endpoint-->>UI: 2.2 200 OK (Mock Assessment Response)
    else Azure Configuration is valid
        note over Endpoint: objectName = "records/{ChildProfileId}/{SessionId}/chunks/chunk_{ChunkIndex}.wav"
        
        Endpoint->>Storage: 3.1 DownloadAsync(objectName, memoryStream, ct)
        activate Storage
        
        alt Download fails
            Storage-->>Endpoint: Exception
            deactivate Storage
            Endpoint-->>UI: 3.2 404 NotFound (Audio chunk not found in storage.)
        else Download succeeds
            activate Storage
            Storage-->>Endpoint: 3.3 File stream response
            deactivate Storage

            Endpoint->>HttpClient: 4.1 PostAsync(Url, StreamContent, CancellationToken)
            activate HttpClient
            note over HttpClient: Headers:<br/>Ocp-Apim-Subscription-Key: {Key}<br/>Pronunciation-Assessment: {Base64-Params}
            
            HttpClient->>Azure: 4.2 HTTP POST request with audio stream
            activate Azure
            
            alt Azure API call fails (!IsSuccessStatusCode)
                Azure-->>HttpClient: HTTP Error Status
                deactivate Azure
                HttpClient-->>Endpoint: Response with error status
                deactivate HttpClient
                Endpoint-->>UI: 4.3 400 BadRequest (Azure Speech API error...)
            else Azure API call exception
                activate HttpClient
                activate Azure
                Azure-->>HttpClient: Network Exception
                deactivate Azure
                HttpClient-->>Endpoint: Exception
                deactivate HttpClient
                Endpoint-->>UI: 4.4 500 InternalServerError (Error communicating with Azure...)
            else Azure API call succeeds
                activate HttpClient
                activate Azure
                Azure-->>HttpClient: 4.5 HTTP 200 OK with analysis JSON
                deactivate Azure
                HttpClient-->>Endpoint: 4.6 Response content
                deactivate HttpClient

                alt NBest Array has items in JSON response
                    Endpoint-->>UI: 4.7 200 OK (NBest[0] assessment result)
                else Plain JSON response
                    Endpoint-->>UI: 4.8 200 OK (Root JSON result)
                end
            end
        end
    end
    deactivate Endpoint
    deactivate UI
