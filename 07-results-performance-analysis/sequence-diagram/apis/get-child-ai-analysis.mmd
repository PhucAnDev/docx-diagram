sequenceDiagram
    title GET /api/analyze/child/{childId}
    actor User as User (Admin/Teacher/Parent)
    participant UI as ChildAnalyzeUI
    participant Endpoint as :AnalyzeController
    participant Service as :AnalyzeService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu hiển thị lịch sử phân tích AI của trẻ
    activate UI
    UI->>Endpoint: 2.1 GET /api/analyze/child/{childId}
    activate Endpoint

    alt childId <= 0
        Endpoint-->>UI: 2.2 400 Bad Request (Invalid child id.)
    else childId valid
        alt User is Parent
            Endpoint->>DB: 3.1.1 ChildProfileRepository.GetByIdAsync(childId)
            activate DB
            DB->>Database: 3.1.2 Execute SELECT query
            activate Database
            Database-->>DB: 3.1.3 ChildProfile entity or null
            deactivate Database
            deactivate DB
            alt Child not owned by Parent
                Endpoint-->>UI: 3.1.4 403 Forbidden
            end
        else User is Teacher
            Endpoint->>DB: 3.2.1 EnrollmentRepository.HasTeacherAccessToChildAsync(currentUserId, childId)
            activate DB
            DB->>Database: 3.2.2 Execute check query
            activate Database
            Database-->>DB: 3.2.3 Access result (true/false)
            deactivate Database
            deactivate DB
            alt Teacher has no access to Child
                Endpoint-->>UI: 3.2.4 403 Forbidden
            end
        end

        Endpoint->>Service: 3.3 GetAnalyzesByChildIdAsync(childId)
        activate Service

        Service->>DB: 3.4 AnalyzeRepository.FindAsync(r => r.ChildId == childId && !r.IsDeleted)
        activate DB
        DB->>Database: 3.5 Execute SELECT query
        activate Database
        Database-->>DB: 3.6 List of Analyze entities
        deactivate Database
        deactivate DB

        Service-->>Endpoint: 3.7 List of AnalyzeResponse
        deactivate Service
        Endpoint-->>UI: 3.8 200 OK (List of AnalyzeResponse)
    end
    deactivate Endpoint
    deactivate UI
