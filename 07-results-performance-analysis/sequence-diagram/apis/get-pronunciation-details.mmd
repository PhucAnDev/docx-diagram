%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title GET /api/pronunciation-details/by-result/{resultId}
    actor User as User (Admin/Teacher/Parent)
    participant UI as ResultDetailsUI
    participant Endpoint as :PronunciationDetailsController
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu hiển thị chi tiết âm vị phát âm lỗi
    activate UI
    UI->>Endpoint: 2.1 GET /api/pronunciation-details/by-result/{resultId}
    activate Endpoint

    Endpoint->>DB: 3.1 ResultRepository.GetByIdAsync(resultId)
    activate DB
    DB->>Database: 3.2 Execute SELECT query
    activate Database
    Database-->>DB: 3.3 Result entity or null
    deactivate Database
    deactivate DB

    alt Result not found
        Endpoint-->>UI: 3.4 404 Not Found (Result not found.)
    else Result exists
        alt User is Parent
            Endpoint->>DB: 3.5.1 ChildProfileRepository.GetByIdAsync(result.ChildId)
            activate DB
            DB->>Database: 3.5.2 Execute SELECT query
            activate Database
            Database-->>DB: 3.5.3 ChildProfile entity or null
            deactivate Database
            deactivate DB
            alt Child not owned by Parent
                Endpoint-->>UI: 3.5.4 403 Forbidden
            end
        else User is Teacher
            Endpoint->>DB: 3.6.1 EnrollmentRepository.HasTeacherAccessToChildAsync(currentUserId, result.ChildId)
            activate DB
            DB->>Database: 3.6.2 Execute check query
            activate Database
            Database-->>DB: 3.6.3 Access result (true/false)
            deactivate Database
            deactivate DB
            alt Teacher has no access to Child
                Endpoint-->>UI: 3.6.4 403 Forbidden
            end
        end

        Endpoint->>DB: 3.7 PronunciationDetailRepository.GetByResultIdAsync(resultId)
        activate DB
        DB->>Database: 3.8 Execute SELECT query
        activate Database
        Database-->>DB: 3.9 List of PronunciationDetails
        deactivate Database
        deactivate DB

        Endpoint-->>UI: 3.10 200 OK (List of PronunciationDetailResponse)
    end
    deactivate Endpoint
    deactivate UI
