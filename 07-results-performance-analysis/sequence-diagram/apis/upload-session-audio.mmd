sequenceDiagram
    title POST /api/files
    actor Parent as Parent (VR Client Uploader)
    participant Endpoint as :FilesController
    participant Storage as :IStorageService
    participant MinIO as :MinIO Cloud Storage

    Parent->>Endpoint: 1.1 POST /api/files (multipart/form-data: ChildProfileId, Metadata file, Audio file)
    activate Endpoint

    alt Metadata or Audio file is null/empty
        Endpoint-->>Parent: 1.2 400 Bad Request
    else Files provided
        note over Endpoint: Generate UUID: folderId = Guid.NewGuid()<br/>metadataObject = "records/{ChildProfileId}/{folderId}/metadata.json"<br/>audioObject = "records/{ChildProfileId}/{folderId}/voice.wav"
        
        Endpoint->>Storage: 2.1 UploadAsync(metadataStream, metadataObject, "application/json", ct)
        activate Storage
        Storage->>MinIO: 2.2 Upload JSON metadata file
        activate MinIO
        MinIO-->>Storage: 2.3 Success
        deactivate MinIO
        Storage-->>Endpoint: 2.4 Upload completed
        deactivate Storage

        Endpoint->>Storage: 3.1 UploadAsync(audioStream, audioObject, "audio/wav", ct)
        activate Storage
        Storage->>MinIO: 3.2 Upload WAV audio file
        activate MinIO
        MinIO-->>Storage: 3.3 Success
        deactivate MinIO
        Storage-->>Endpoint: 3.4 Upload completed
        deactivate Storage

        Endpoint-->>Parent: 3.5 200 OK (UploadFilesResponse containing folderId)
    end
    deactivate Endpoint
