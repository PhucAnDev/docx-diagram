sequenceDiagram
    title POST /api/Report
    actor User as User (Admin/Teacher/Parent)
    participant UI as CreateReportUI
    participant Endpoint as :ReportController
    participant Service as :ReportService
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu xuất báo cáo học tập (chọn phân tích AI, định dạng, link file)
    activate UI
    UI->>Endpoint: 2.1 POST /api/Report (CreateReportRequest)
    activate Endpoint

    Endpoint->>Service: 3.1 CreateReportAsync(generatedBy, request)
    activate Service

    Service->>DB: 3.2 AnalyzeRepository.GetFirstOrDefaultAsync(a => a.Id == request.AnalyzeId && !a.IsDeleted, includeProperties: "Child.Results")
    activate DB
    DB->>Database: 3.3 Execute SELECT query with child, results
    activate Database
    Database-->>DB: 3.4 Analyze entity with Child and Results
    deactivate Database
    deactivate DB

    alt Analyze not found
        Service-->>Endpoint: 3.5.1 (Succeeded = false, Error = "Analyze '...' không tồn tại.")
        deactivate Service
        Endpoint-->>UI: 3.5.2 400 Bad Request (Create report failed.)
    else Analyze exists
        activate Service
        alt No finalized results found for Child
            Service-->>Endpoint: 3.6.1 (Succeeded = false, Error = "Không có Result nào được finalized để generate report.")
            deactivate Service
            Endpoint-->>UI: 3.6.2 400 Bad Request (Create report failed.)
        else Finalized results exist
            activate Service
            note over Service: Create Report entity
            
            Service->>DB: 3.7 ReportRepository.AddAsync(report)
            Service->>DB: 3.8 SaveChangesAsync()
            activate DB
            DB->>Database: 3.9 Execute INSERT query
            activate Database
            Database-->>DB: 3.10 Rows affected
            deactivate Database
            deactivate DB

            Service->>DB: 3.11 ReportRepository.GetFirstOrDefaultAsync(r => r.Id == report.Id, includeProperties: "GeneratedByUser")
            activate DB
            DB->>Database: 3.12 Execute SELECT query
            activate Database
            Database-->>DB: 3.13 Created Report entity with user details
            deactivate Database
            deactivate DB

            Service-->>Endpoint: 3.14 (Succeeded = true, ReportResponse)
            deactivate Service
            Endpoint-->>UI: 3.15 200 OK (Report created.)
        end
    end
    deactivate Endpoint
    deactivate UI
