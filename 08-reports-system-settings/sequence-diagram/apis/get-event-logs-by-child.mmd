sequenceDiagram
    title GET /api/event-logs/by-child/{childId}
    actor User as User (Admin/Teacher/Parent)
    participant UI as EventLogsUI
    participant Endpoint as :EventLogsController
    participant DB as :UnitOfWork
    participant Database as :Database

    User->>UI: 1.1 Yêu cầu xem toàn bộ nhật ký sự kiện tiến trình của học sinh
    activate UI
    UI->>Endpoint: 2.1 GET /api/event-logs/by-child/{childId}
    activate Endpoint

    Endpoint->>DB: 3.1 ChildProfileRepository.GetByIdAsync(childId)
    activate DB
    DB->>Database: 3.2 Execute SELECT query
    activate Database
    Database-->>DB: 3.3 ChildProfile entity or null
    deactivate Database
    deactivate DB

    alt Child not found
        Endpoint-->>UI: 3.4 404 Not Found (Child not found.)
    else Child exists
        alt User is Parent
            alt Child not owned by Parent (child.UserId != currentUserId)
                Endpoint-->>UI: 3.5 403 Forbidden
            end
        else User is Teacher
            Endpoint->>DB: 3.6.1 EnrollmentRepository.HasTeacherAccessToChildAsync(currentUserId, childId)
            activate DB
            DB->>Database: 3.6.2 Execute check query
            activate Database
            Database-->>DB: 3.6.3 Access result (true/false)
            deactivate Database
            deactivate DB
            alt Teacher has no access to Child
                Endpoint-->>UI: 3.6.4 403 Forbidden
            end
        end

        Endpoint->>DB: 3.7 EventLogRepository.GetByChildIdAsync(childId)
        activate DB
        DB->>Database: 3.8 Execute SELECT query
        activate Database
        Database-->>DB: 3.9 List of EventLogs
        deactivate Database
        deactivate DB

        Endpoint-->>UI: 3.10 200 OK (List of EventLogResponse)
    end
    deactivate Endpoint
    deactivate UI
