%%{init: {'theme':'base', 'themeVariables': {'actorBkg':'#ffffff','actorBorder':'#000000','actorTextColor':'#000000','actorLineColor':'#000000','signalColor':'#000000','signalTextColor':'#000000','labelBoxBkgColor':'#ffffff','labelBoxBorderColor':'#000000','labelTextColor':'#000000','loopTextColor':'#000000','noteBkgColor':'#ffffff','noteBorderColor':'#000000','noteTextColor':'#000000','activationBorderColor':'#000000','activationBkgColor':'#ffffff','sequenceNumberColor':'#000000'}, 'sequence': {'width':150,'height':65,'actorFontSize':16,'messageFontSize':16,'wrap':true,'wrapPadding':10}}}%%
sequenceDiagram
    title PUT /api/school-years/{id}
    actor Admin as Admin
    participant UI as UpdateSchoolYearUI
    participant Endpoint as :SchoolYearsController
    participant Service as :SchoolYearService
    participant DB as :UnitOfWork
    participant Database as :Database

    Admin->>UI: 1.1 Sửa thông tin niên khóa và nhấn Lưu
    activate UI
    UI->>Endpoint: 2.1 PUT /api/school-years/{id} (UpdateSchoolYearRequest)
    activate Endpoint

    alt id <= 0
        Endpoint-->>UI: 2.2 400 Bad Request (Invalid school year id.)
    else id > 0
        Endpoint->>Service: 3.1 UpdateSchoolYearAsync(id, request)
        activate Service

        Service->>DB: 3.2 SchoolYearRepository.GetFirstOrDefaultAsync(sy => sy.Id == id && !sy.IsDeleted)
        activate DB
        DB->>Database: 3.3 Execute SELECT query
        activate Database
        Database-->>DB: 3.4 SchoolYear entity or null
        deactivate Database
        deactivate DB

        alt SchoolYear not found
            Service-->>Endpoint: 3.5.1 (Succeeded = false, NotFound = true)
            deactivate Service
            Endpoint-->>UI: 3.5.2 404 Not Found (School year not found.)
        else SchoolYear exists
            activate Service
            alt BR-43: request.StartDate >= request.EndDate
                Service-->>Endpoint: 3.6.1 (Succeeded = false, Error = "Ngày bắt đầu phải trước...")
                deactivate Service
                Endpoint-->>UI: 3.6.2 400 Bad Request (Update school year failed.)
            else Date range valid
                activate Service
                Service->>DB: 3.7 SchoolYearRepository.HasOverlappingAsync(request.StartDate, request.EndDate, excludeId: id)
                activate DB
                DB->>Database: 3.8 Execute overlap check query
                activate Database
                Database-->>DB: 3.9 Overlap result (true/false)
                deactivate Database
                deactivate DB

                alt Overlapping school year exists
                    Service-->>Endpoint: 3.10.1 (Succeeded = false, Error = "Thời gian niên khóa bị trùng lặp...")
                    deactivate Service
                    Endpoint-->>UI: 3.10.2 400 Bad Request (Update school year failed.)
                else No overlap
                    activate Service
                    alt request.Status == "Active" and schoolYear.Status != "Active"
                        Service->>DB: 3.11.1 SchoolYearRepository.HasActiveSchoolYearAsync(excludeId: id)
                        activate DB
                        DB->>Database: 3.11.2 Execute active check query
                        activate Database
                        Database-->>DB: 3.11.3 Active check result (true/false)
                        deactivate Database
                        deactivate DB

                        alt Already has another Active school year
                            Service-->>Endpoint: 3.12.1 (Succeeded = false, Error = "Đã có một niên khóa khác đang ở trạng thái Hoạt động.")
                            deactivate Service
                            Endpoint-->>UI: 3.12.2 400 Bad Request (Update school year failed.)
                        else Unique Active status
                            activate Service
                            note over Service: Update fields
                        end
                    else Status check valid
                        note over Service: Update fields
                    end

                    note over Service: Save updates
                    Service->>DB: 3.13 SaveChangesAsync()
                    activate DB
                    DB->>Database: 3.14 Execute UPDATE query
                    activate Database
                    Database-->>DB: 3.15 Rows affected
                    deactivate Database
                    deactivate DB

                    Service-->>Endpoint: 3.16 (Succeeded = true, SchoolYearResponse)
                    deactivate Service
                    Endpoint-->>UI: 3.17 200 OK (School year updated.)
                end
            end
        end
    end
    deactivate Endpoint
    deactivate UI
