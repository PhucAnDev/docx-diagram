classDiagram
    direction TB

    class ReportController {
        -reportService: IReportService
        +Create(request: CreateReportRequest) Task~ActionResult~
    }

    class CreateReportRequest {
        +AnalyzeId: int
        +ReportFormat: string
        +FileUrl: string
    }

    class IReportService {
        <<interface>>
        +CreateReportAsync(generatedBy: int, request: CreateReportRequest) Task~Tuple~bool,IEnumerable~string~,ReportResponse~~~~
    }

    class ReportService {
        -unitOfWork: IUnitOfWork
        +CreateReportAsync(generatedBy: int, request: CreateReportRequest) Task~Tuple~bool,IEnumerable~string~,ReportResponse~~~~
    }

    class IUnitOfWork {
        <<interface>>
        +ReportRepository: IReportRepository
        +AnalyzeRepository: IAnalyzeRepository
        +SaveChangesAsync() Task~int~
    }

    class UnitOfWork {
        -context: AppDbContext
        +ReportRepository: IReportRepository
        +AnalyzeRepository: IAnalyzeRepository
        +SaveChangesAsync() Task~int~
    }

    class ReportResponse {
        +Id: int
        +AnalyzeId: int
        +GeneratedBy: int
        +GeneratedByName: string
        +ReportFormat: string
        +FileUrl: string
        +GeneratedAt: DateTime
    }

    class Report {
        +AnalyzeId: int
        +GeneratedBy: int
        +ReportFormat: string
        +FileUrl: string
    }

    class Analyze {
        +ChildId: int
    }

    class User {
        +FullName: string
    }

    ReportController ..> CreateReportRequest : uses
    ReportController ..> IReportService : uses
    IReportService <.. ReportService : implements
    ReportService ..> IUnitOfWork : uses
    ReportService ..> ReportResponse : uses
    IUnitOfWork <.. UnitOfWork : implements
    UnitOfWork ..> Report : uses
    UnitOfWork ..> Analyze : uses
    UnitOfWork ..> User : uses
    Report ..> Analyze : belongs to
    Report ..> User : generated by
